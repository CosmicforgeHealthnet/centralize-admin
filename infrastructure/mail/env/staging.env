# Staging Mail profile: settings that are NOT secret. Installed by
# .github/workflows/ca-mail-env-install.yml (target=staging), under the
# CA_STAGING_MAIL_ENV secret, which overrides any of these and supplies what
# must not be committed (MAIL_TEST_RECIPIENT_ALLOWLIST: the approved test
# inbox addresses). With provider_credentials=shared-from-production the
# Resend API key and webhook secret are taken from CA_PRODUCTION_MAIL_ENV.
# No RESEND_* key and no *_ENABLED switch belongs in this file.
MAIL_DEPLOYMENT_ENV=staging
MAIL_PROVIDER=resend
MAIL_PROVIDER_ENVIRONMENT_TAG=staging
MAIL_DOMAIN_ALLOWLIST=karryam.com
MAIL_RESERVED_SENDER_ADDRESSES=no-reply@karryam.com
# One Resend webhook, pointed at production: production owns inbound mail.
MAIL_INBOUND_ACTIVE_ENVIRONMENT=production
MAIL_MIXED_RECIPIENT_MODE=external-only
MAIL_UNKNOWN_RECIPIENT_POLICY=reject
MAIL_PUBLIC_API_URL=https://stagingca.cosmicforge-healthnet.com
MAIL_PUBLIC_APP_URL=https://centralize-admin-staging.vercel.app
