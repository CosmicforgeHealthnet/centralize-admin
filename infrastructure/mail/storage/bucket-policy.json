{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${MAIL_BUCKET}", "arn:aws:s3:::${MAIL_BUCKET}/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyUnencryptedObjectUploads",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${MAIL_BUCKET}/*",
      "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "aws:kms" } }
    },
    {
      "Sid": "DenyWrongKmsKey",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${MAIL_BUCKET}/*",
      "Condition": { "StringNotEqualsIfExists": { "s3:x-amz-server-side-encryption-aws-kms-key-id": "${SSE_KMS_KEY_ARN}" } }
    },
    {
      "Sid": "DenyPublicAcls",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:PutObject", "s3:PutObjectAcl"],
      "Resource": "arn:aws:s3:::${MAIL_BUCKET}/*",
      "Condition": { "StringEquals": { "s3:x-amz-acl": ["public-read", "public-read-write", "authenticated-read"] } }
    },
    {
      "Sid": "DenyEveryoneButMailRoles",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${MAIL_BUCKET}/*",
      "Condition": { "ArnNotLike": { "aws:PrincipalArn": ["${MAIL_API_ROLE_ARN}", "${MAIL_ROTATION_ROLE_ARN}", "${BREAK_GLASS_ADMIN_ROLE_ARN}"] } }
    }
  ]
}
