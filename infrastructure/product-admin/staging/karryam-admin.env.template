# Karryam Admin staging configuration TEMPLATE (Section 12.3.2).
# Copy to /etc/cosmicforge/staging/karryam-admin.env (root:root 0600) and
# replace every <...>. Never commit the filled file. Secret VALUES live in
# files under /etc/cosmicforge/staging/secrets/karryam-admin/ (root:10001,
# dir 0750, files 0440), mounted read-only at /run/secrets/karryam-admin.
# KARRYAM_ADMIN_ENVIRONMENT=staging and KARRYAM_ADMIN_LISTEN are set by the
# compose file and cannot be overridden here.

# --- activation (all false until the release stage allows it) -------------
KARRYAM_ADMIN_ENABLED=false
KARRYAM_BRIDGE_ENABLED=false
KARRYAM_BRIDGE_FEED_ENABLED=false

# --- identity ---------------------------------------------------------------
KARRYAM_ADMIN_SERVICE_INSTANCE_ID=karryam-admin-staging-1
KARRYAM_ADMIN_WORKLOAD_IDENTITY=cf://staging/product-admin/karryam
KARRYAM_ADMIN_BUILD_SHA=<release commit SHA>

# --- DB-B (runtime role only; the migration role is in karryam-admin.migrate.env)
KARRYAM_ADMIN_DATABASE_URL=postgresql://karryam_admin_runtime:<runtime password>@karryam-admin-db:5432/karryam_admin

# --- HQ (PIC) trust ------------------------------------------------------------
KARRYAM_ADMIN_HQ_SERVICE_KEYS_FILE=/run/secrets/karryam-admin/hq-service-keys.json
KARRYAM_ADMIN_DELEGATION_KEYS_FILE=/run/secrets/karryam-admin/delegation-keys.json
KARRYAM_ADMIN_MANIFEST_SIGNING_KEY_FILE=/run/secrets/karryam-admin/manifest-signer.pem
KARRYAM_ADMIN_MANIFEST_SIGNING_KID=<kid enrolled in PIC trusted-signers>
KARRYAM_ADMIN_CURSOR_KEY_FILE=/run/secrets/karryam-admin/cursor-key

# --- Bridge enrollment (values come from the Karryam Backoffice owner) -------
# KARRYAM_BRIDGE_ORIGIN=https://<bridge server name>:8110
# KARRYAM_BRIDGE_ADDRESS=<fixed private IP on cf-staging-karryam-bridge, e.g. 10.231.12.10>
# KARRYAM_BRIDGE_CA_FILE=/run/secrets/karryam-admin/bridge-ca.pem
# KARRYAM_BRIDGE_CLIENT_CERT_FILE=/run/secrets/karryam-admin/bridge-client.pem
# KARRYAM_BRIDGE_CLIENT_KEY_FILE=/run/secrets/karryam-admin/bridge-client.key
# KARRYAM_BRIDGE_CLIENT_URI=<workload URI SAN in the client certificate>
# KARRYAM_BRIDGE_SERVER_FINGERPRINTS=<sha256 of the Bridge server certificate>
# KARRYAM_BRIDGE_REVOKED_FINGERPRINTS=
# KARRYAM_BRIDGE_HMAC_KEY_FILE=/run/secrets/karryam-admin/bridge-hmac-key
# KARRYAM_BRIDGE_SERVICE_KID=<HMAC key id enrolled at the Bridge>
# KARRYAM_BRIDGE_STAFF_PRIVATE_KEY_FILE=/run/secrets/karryam-admin/bridge-staff-ed25519.pem
# KARRYAM_BRIDGE_STAFF_KID=<staff assertion key id enrolled at the Bridge>
# KARRYAM_BRIDGE_ISSUER=<issuer enrolled at the Bridge>
# KARRYAM_BRIDGE_AUDIENCE=<audience enrolled at the Bridge>
# KARRYAM_ADMIN_MARKET=<enrolled market, never *>
# KARRYAM_ADMIN_ORGANIZATION=<enrolled organization, never *>
# KARRYAM_ADMIN_ZONES=<comma list of enrolled zones>
# KARRYAM_ADMIN_TENANTS=<comma list of enrolled tenants>
# KARRYAM_ADMIN_ACR=<required ACR>
# KARRYAM_ADMIN_ROLE_MAP={"<hq product grant role>":"<bridge role>"}

# --- Stage A feed (S4 only) -------------------------------------------------
# KARRYAM_BRIDGE_FEED_SCOPES=[{"market":"<m>","organization":"<o>","zone":"<z>","tenant":"<t>"}]
# KARRYAM_BRIDGE_FEED_CONSUMER=<approved consumer name>
# KARRYAM_BRIDGE_FEED_SUBJECT=<approved workload subject>
# KARRYAM_BRIDGE_FEED_ROLE=<approved bridge role>
# KARRYAM_BRIDGE_FEED_ACR=workload

# --- datasets and commands (S5/S6 only; empty = none) ------------------------
KARRYAM_ADMIN_CERTIFIED_DATASETS=
KARRYAM_ADMIN_ENABLED_COMMANDS=

# --- staging isolation preflight --------------------------------------------
PRODUCT_ADMIN_PRODUCTION_DENYLIST=<comma list of production DB/Bridge hostnames and IPs>
