# CF Meet Admin staging configuration TEMPLATE (Section 12.3.2).
# Copy to /etc/cosmicforge/staging/cfmeet-admin.env (root:root 0600) and
# replace every <...>. Never commit the filled file. Secret VALUES live in
# files under /etc/cosmicforge/staging/secrets/cfmeet-admin/ (root:10003,
# dir 0750, files 0440), mounted read-only at /run/secrets/cfmeet-admin.
# CFMEET_ADMIN_ENVIRONMENT=staging and CFMEET_ADMIN_LISTEN are set by the
# compose file and cannot be overridden here. Mirrors karryam-admin.env.template
# 1:1 (CF Meet has no FEED_PURPOSE; it adds the dataset puller variables).
# CF Meet Admin runs as uid/gid 10003 and has its own database server
# (cfmeet-admin-db on cf-staging-cfmeet-admin-db); it shares nothing with
# Karryam Admin.
# Deliberately absent: CFMEET_ADMIN_LISTEN (compose), CFMEET_ADMIN_TLS_* and
# CFMEET_ADMIN_ALLOWED_CLIENT_FINGERPRINTS (unix socket, no tcp listener), and
# CFMEET_ADMIN_MIGRATION_DATABASE_URL / CFMEET_ADMIN_RUNTIME_ROLE (migrate env only).

# --- activation (all false until the release stage allows it) -------------
CFMEET_ADMIN_ENABLED=false
CFMEET_BRIDGE_ENABLED=false
CFMEET_BRIDGE_FEED_ENABLED=false

# --- identity ---------------------------------------------------------------
CFMEET_ADMIN_SERVICE_INSTANCE_ID=cfmeet-admin-staging-1
CFMEET_ADMIN_WORKLOAD_IDENTITY=cf://staging/product-admin/cfmeet
CFMEET_ADMIN_BUILD_SHA=<release commit SHA>

# --- CF Meet Admin database (runtime role only; the migration role is in cfmeet-admin.migrate.env)
CFMEET_ADMIN_DATABASE_URL=postgresql://cfmeet_admin_runtime:<runtime password>@cfmeet-admin-db:5432/cfmeet_admin

# --- HQ (PIC) trust ------------------------------------------------------------
CFMEET_ADMIN_HQ_SERVICE_KEYS_FILE=/run/secrets/cfmeet-admin/hq-service-keys.json
CFMEET_ADMIN_DELEGATION_KEYS_FILE=/run/secrets/cfmeet-admin/delegation-keys.json
CFMEET_ADMIN_MANIFEST_SIGNING_KEY_FILE=/run/secrets/cfmeet-admin/manifest-signer.pem
# Ed25519 PKCS#8 PEM; the kid must equal the cfmeet entry in PIC trusted-signers.json.
CFMEET_ADMIN_MANIFEST_SIGNING_KID=cfmeet-staging-manifest-2026-11
# CFMEET_ADMIN_MANIFEST_REVISION=1
# CFMEET_ADMIN_MANIFEST_TTL_SECONDS=3600
CFMEET_ADMIN_CURSOR_KEY_FILE=/run/secrets/cfmeet-admin/cursor-key

# --- Bridge enrollment (values come from the CF Meet Admin Bridge owner) -----
# Bridge base path /internal/cfmeet-admin/v1; HQ principal cosmicforge-hq-cfmeet-admin.
# CFMEET_BRIDGE_ORIGIN=https://<bridge server name>:8110
# CFMEET_BRIDGE_ADDRESS=<fixed private IP on cf-staging-cfmeet-bridge, e.g. 10.231.14.10>
# CFMEET_BRIDGE_CA_FILE=/run/secrets/cfmeet-admin/bridge-ca.pem
# CFMEET_BRIDGE_CLIENT_CERT_FILE=/run/secrets/cfmeet-admin/bridge-client.pem
# CFMEET_BRIDGE_CLIENT_KEY_FILE=/run/secrets/cfmeet-admin/bridge-client.key
# CFMEET_BRIDGE_CLIENT_URI=<workload URI SAN in the client certificate>
# CFMEET_BRIDGE_SERVER_FINGERPRINTS=<sha256 of the Bridge server certificate>
# CFMEET_BRIDGE_REVOKED_FINGERPRINTS=
# CFMEET_BRIDGE_HMAC_KEY_FILE=/run/secrets/cfmeet-admin/bridge-hmac-key
# CFMEET_BRIDGE_SERVICE_KID=<HMAC key id enrolled at the Bridge>
# CFMEET_BRIDGE_STAFF_PRIVATE_KEY_FILE=/run/secrets/cfmeet-admin/bridge-staff-ed25519.pem
# CFMEET_BRIDGE_STAFF_KID=<staff assertion key id enrolled at the Bridge>
# CFMEET_BRIDGE_ISSUER=cosmicforge-hq
# CFMEET_BRIDGE_AUDIENCE=cfmeet-admin-bridge
# CFMEET_ADMIN_MARKET=<enrolled market, never *>
# CFMEET_ADMIN_ORGANIZATION=<enrolled organization, never *>
# CFMEET_ADMIN_ZONES=<comma list of enrolled zones>
# CFMEET_ADMIN_TENANTS=<comma list of enrolled tenants>
# CFMEET_ADMIN_ACR=urn:cosmicforge:acr:mfa
# CFMEET_ADMIN_ROLE_MAP={"<hq product grant role>":"<bridge role>"}
# CFMEET_ADMIN_BRIDGE_MFA_MAX_AGE_SECONDS=300

# --- Stage A feed (S4 only) -------------------------------------------------
# CFMEET_BRIDGE_FEED_SCOPES=[{"market":"<m>","organization":"<o>","zone":"<z>","tenant":"<t>"}]
# CFMEET_BRIDGE_FEED_CONSUMER=<approved consumer name>
# CFMEET_BRIDGE_FEED_SUBJECT=<approved workload subject>
# CFMEET_BRIDGE_FEED_ROLE=cfmeet.source_sync
# CFMEET_BRIDGE_FEED_ACR=urn:cosmicforge:acr:workload
# CFMEET_BRIDGE_FEED_PAGE_SIZE=50
# CFMEET_BRIDGE_FEED_POLL_SECONDS=15
# CFMEET_BRIDGE_FEED_REWIND_EVENTS=200
# CFMEET_BRIDGE_FEED_LEASE_SECONDS=60
# Certified Bridge datasets (bridge.datasets.read) pulled as daily series:
# every N seconds (300-86400), reading the last D UTC days (1-31).
# CFMEET_BRIDGE_DATASET_PULL_SECONDS=900
# CFMEET_BRIDGE_DATASET_DAYS=3
# CFMEET_BRIDGE_RECONCILE_INTERVAL_SECONDS=86400
# CFMEET_ADMIN_INBOX_RETENTION_DAYS=90

# --- datasets and commands (S5/S6 only; empty = none) ------------------------
CFMEET_ADMIN_CERTIFIED_DATASETS=
CFMEET_ADMIN_ENABLED_COMMANDS=

# --- staging isolation preflight --------------------------------------------
PRODUCT_ADMIN_PRODUCTION_DENYLIST=<comma list of production DB/CF Meet Bridge hostnames and IPs>
