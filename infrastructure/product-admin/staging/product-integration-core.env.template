# Product Integration Core staging configuration TEMPLATE (Section 12.3.1).
# Copy to /etc/cosmicforge/staging/product-integration-core.env (root:root
# 0600) and replace every <...>. Never commit the filled file. Secret files
# live in /etc/cosmicforge/staging/secrets/product-integration-core/
# (root:10002, dir 0750, files 0440), mounted read-only at
# /run/secrets/product-integration-core. PIC_ENVIRONMENT=staging and
# PIC_LISTEN are set by the compose file.

PIC_ENABLED=false
PIC_SYNC_ENABLED=false

# DB-A, schema hq_integration, runtime role only (migration role: product-integration-core.migrate.env)
PIC_DATABASE_URL=postgresql://pic_runtime:<runtime password>@hq-db:5432/cosmicforge_admin

PIC_ENDPOINTS_FILE=/run/secrets/product-integration-core/endpoints.json
PIC_TRUSTED_SIGNERS_FILE=/run/secrets/product-integration-core/trusted-signers.json
PIC_HQ_DELEGATION_KEYS_FILE=/run/secrets/product-integration-core/hq-delegation-keys.json

# Optional bounds (defaults shown)
# PIC_TRUST_STORE_RECHECK_SECONDS=5
# PIC_SYNC_INTERVAL_SECONDS=60
# PIC_SYNC_LEASE_SECONDS=30
# PIC_WORKER_ID=pic-staging-1

PRODUCT_ADMIN_PRODUCTION_DENYLIST=<comma list of production DB/Product Admin hostnames and IPs>
