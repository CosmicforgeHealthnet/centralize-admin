# This is an independent service. Do not reuse any HQ session signing keys.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Generate and store securely; minimum 32 UTF-8 bytes. Never commit live secrets.
HEALTHNET_INTERNAL_JWT_SECRET=
# HealthNet platform owner-approved HTTPS read-only ADMIN aggregate API.
HEALTHNET_PLATFORM_ADMIN_BASE_URL=
HEALTHNET_PLATFORM_ADMIN_TOKEN=
# Contract mappings are intentionally empty until the owner approves each path.
HEALTHNET_PLATFORM_ADMIN_METRICS_PATH=
HEALTHNET_PLATFORM_ADMIN_ACTIVITY_PATH=
HEALTHNET_PLATFORM_ADMIN_PATIENTS_PATH=
HEALTHNET_PLATFORM_ADMIN_REVENUE_PATH=
HEALTHNET_UPSTREAM_TIMEOUT_MS=4000
