# Only same-VPS Unix-socket access. Do not bind a public TCP port.
KARRYAM_ADMIN_ENABLED=false
KARRYAM_ADMIN_SOCKET_PATH=/run/cosmicforge/karryam-admin.sock
# Match these to independently approved KarryGo trust policy.
KARRYAM_ADMIN_MARKET=
KARRYAM_ADMIN_ORGANIZATION=
KARRYAM_ADMIN_ACR=
# Example shape: {"SUPER":"approved-read-role"}; no role is implicit.
KARRYAM_ADMIN_ROLE_MAP={}
# Same file contents mounted only into Central Admin API and this service;
# use a different key from all browser cookies, JWTs and bridge HMAC keys.
KARRYAM_HQ_DELEGATION_SECRET_FILE=
# Bridge is TLS 1.3 + mTLS even when co-located.
KARRYAM_BRIDGE_ORIGIN=
KARRYAM_BRIDGE_CA_FILE=
KARRYAM_BRIDGE_CLIENT_CERT_FILE=
KARRYAM_BRIDGE_CLIENT_KEY_FILE=
KARRYAM_BRIDGE_HMAC_KEY_FILE=
KARRYAM_BRIDGE_SERVICE_KID=
KARRYAM_BRIDGE_STAFF_PRIVATE_KEY_FILE=
KARRYAM_BRIDGE_STAFF_KID=
KARRYAM_BRIDGE_ISSUER=
KARRYAM_BRIDGE_AUDIENCE=
