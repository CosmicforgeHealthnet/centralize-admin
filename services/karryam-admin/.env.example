# Karryam Admin — example configuration. DISABLED by default.
# Never commit real values. Every secret is read from an operator-mounted
# file referenced by an absolute path; nothing secret is placed in env vars.

KARRYAM_ADMIN_ENABLED=false

# Private-only listener. Default: host-private Unix socket (mode 0660).
#   unix:/run/cosmicforge/karryam-admin.sock
#   tcp:<loopback-or-private-ip>:<port>   (non-loopback requires mTLS below)
KARRYAM_ADMIN_LISTEN=unix:/run/cosmicforge/karryam-admin.sock

# Required when enabled.
KARRYAM_ADMIN_ENVIRONMENT=
KARRYAM_ADMIN_SERVICE_INSTANCE_ID=
# Must match the identity independently approved in the HQ registry.
KARRYAM_ADMIN_WORKLOAD_IDENTITY=
KARRYAM_ADMIN_BUILD_SHA=
# Dedicated Karryam Admin database, RUNTIME role (INSERT/SELECT only on audit).
KARRYAM_ADMIN_DATABASE_URL=
# HQ Product Integration Core service keys: JSON {"<keyId>":{"service_id":"hq-product-integration-core","key_b64url":"...","not_after":"<ISO>"}}
KARRYAM_ADMIN_HQ_SERVICE_KEYS_FILE=
# Delegated staff context keys: JSON {"<kid>":{"key_b64url":"...","not_after":"<ISO>"}}
KARRYAM_ADMIN_DELEGATION_KEYS_FILE=

# Manifest signer (optional). Without it GET /manifest answers
# UNAVAILABLE MANIFEST_SIGNER_NOT_PROVISIONED. Ed25519 PKCS#8 PEM.
KARRYAM_ADMIN_MANIFEST_SIGNING_KEY_FILE=
KARRYAM_ADMIN_MANIFEST_SIGNING_KID=
KARRYAM_ADMIN_MANIFEST_REVISION=1
KARRYAM_ADMIN_MANIFEST_TTL_SECONDS=3600

# Mutual TLS — required for a non-loopback tcp: listener.
KARRYAM_ADMIN_TLS_CERT_FILE=
KARRYAM_ADMIN_TLS_KEY_FILE=
KARRYAM_ADMIN_TLS_CLIENT_CA_FILE=
# Comma-separated SHA-256 fingerprints of approved HQ client certificates.
KARRYAM_ADMIN_ALLOWED_CLIENT_FINGERPRINTS=

# Migration credential — used ONLY by `npm run migrate`, never by the server.
KARRYAM_ADMIN_MIGRATION_DATABASE_URL=
KARRYAM_ADMIN_RUNTIME_ROLE=

# Karryam Backoffice Bridge (read-only capability discovery). Disabled until
# KarryGo enrolls the HQ client certificate, HMAC key and staff signing key.
KARRYAM_BRIDGE_ENABLED=false
# https://<bridge-hostname>:<port> — used for TLS server name only.
KARRYAM_BRIDGE_ORIGIN=
# Pinned private IP of the bridge (DNS is never consulted).
KARRYAM_BRIDGE_ADDRESS=
KARRYAM_BRIDGE_CA_FILE=
KARRYAM_BRIDGE_CLIENT_CERT_FILE=
KARRYAM_BRIDGE_CLIENT_KEY_FILE=
KARRYAM_BRIDGE_HMAC_KEY_FILE=
KARRYAM_BRIDGE_SERVICE_KID=
KARRYAM_BRIDGE_STAFF_PRIVATE_KEY_FILE=
KARRYAM_BRIDGE_STAFF_KID=
KARRYAM_BRIDGE_ISSUER=
KARRYAM_BRIDGE_AUDIENCE=
# Must match KarryGo's approved trust policy.
KARRYAM_ADMIN_MARKET=
KARRYAM_ADMIN_ORGANIZATION=
KARRYAM_ADMIN_ACR=
# HQ product grant role -> approved bridge role. Staff tiers are rejected.
# Example shape: {"karryam.capabilities.viewer":"<approved-bridge-read-role>"}
KARRYAM_ADMIN_ROLE_MAP={}
