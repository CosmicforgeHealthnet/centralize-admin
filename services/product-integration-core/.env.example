# Product Integration Core (HQ). Disabled by default. Never commit real values.
PIC_ENABLED=false
# test | development | staging | production — one PIC instance serves exactly one environment.
PIC_ENVIRONMENT=
# Private listener: unix socket shared only with the Central Admin API (default),
# or tcp:127.0.0.1:<port>. Remote TCP requires a TLS 1.3 mTLS infrastructure step.
PIC_LISTEN=unix:/run/cosmicforge/product-integration-core.sock
# Runtime credential (DML only on hq_integration.*). Must differ from the migration credential.
PIC_DATABASE_URL=
# Migration/operator credential — used ONLY by scripts/migrate.js and scripts/bootstrap-platform-grant.js.
PIC_MIGRATION_DATABASE_URL=
# Operator-provisioned runtime role that receives the runtime grants during migration.
PIC_RUNTIME_ROLE=
# Operator-controlled JSON files (see infrastructure/product-admin/*.example.json).
PIC_ENDPOINTS_FILE=
PIC_TRUSTED_SIGNERS_FILE=
PIC_HQ_DELEGATION_KEYS_FILE=
# Scheduled synchronization and health/drift checks (off until certified).
PIC_SYNC_ENABLED=false
PIC_SYNC_INTERVAL_SECONDS=60
PIC_SYNC_LEASE_SECONDS=30
PIC_WORKER_ID=
# Only for disposable test/development environments; refused for staging/production.
PIC_ALLOW_INSECURE_LOOPBACK=false
