{
  "name": "@cosmicforge/product-integration-core",
  "version": "0.1.0",
  "private": true,
  "description": "Headquarters Product Integration Core: product registry, onboarding, subscriptions and generic Product Admin synchronization",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "node src/server/index.js",
    "migrate": "node scripts/migrate.js",
    "config:check": "node scripts/check-config.js",
    "check": "node -e \"for (const f of require('node:fs').readdirSync('src',{recursive:true})) if (f.endsWith('.js')) require('node:child_process').execFileSync(process.execPath,['--check','src/'+f])\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "pg": "8.20.0"
  }
}
