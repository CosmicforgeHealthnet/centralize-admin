# --------------------------------------------------
# Core
# --------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/cosmicforge_admin
ADMIN_JWT_SECRET=
MAIN_BACKEND_JWT_SECRET=
MAIN_BACKEND_URL=
CORS_ORIGINS=http://localhost:3000

# ── HQ sessions (docs/hq-auth-sessions-and-mfa.md) ─────────────────────────
# legacy (default, unchanged contract) | dual (cookies + body token) | cookie
AUTH_SESSION_MODE=legacy
# none for cross-site frontend/API (forces Secure); lax when same-site
AUTH_COOKIE_SAMESITE=
AUTH_COOKIE_SECURE=
# Optional parent domain, e.g. .cosmiforgegroup.cloud (disables the __Host- prefix)
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=720
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=168
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_MAX_SESSIONS_PER_USER=10
# Optional; defaults to a key derived from ADMIN_JWT_SECRET
AUTH_CSRF_SECRET=

# ── HQ MFA ──────────────────────────────────────────────────────────────────
# Keyring for encrypting TOTP secrets: "k1:<base64 32 bytes>,k2:<base64 32 bytes>"
# MFA enrollment fails closed (503) when unset. Store in the secret manager.
AUTH_MFA_ENCRYPTION_KEYS=
AUTH_MFA_ENCRYPTION_ACTIVE_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --------------------------------------------------
# Admin Google OAuth
# --------------------------------------------------
# Leave all three values blank to disable optional Google login locally and in CI.
# Provide all three together to enable Google login. Staging/production callbacks
# must use an exact HTTPS URL with no wildcard or request-derived redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --------------------------------------------------
# Main application database
# --------------------------------------------------
MAIN_DB_ENV=dev
MAIN_DATABASE_URL_DEV=
MAIN_DATABASE_URL_PROD=

# --------------------------------------------------
# Email
# --------------------------------------------------
CPANEL_EMAIL_HOST=
CPANEL_EMAIL_PORT=
CPANEL_EMAIL_SECURE=
CPANEL_EMAIL_USER=
CPANEL_EMAIL_PASS=
CPANEL_EMAIL_FROM=

# Account setup / password links (no emailed passwords). The link secret is
# placed in the URL fragment of this page. Defaults to $FRONTEND_URL/account-setup.
ACCOUNT_SETUP_URL=
# Lifetimes: invitations and lab admin setup in hours, HR-approved resets in minutes.
ACCOUNT_SETUP_INVITE_TTL_HOURS=48
ACCOUNT_SETUP_LAB_TTL_HOURS=48
ACCOUNT_SETUP_RESET_TTL_MINUTES=30
# Where lab admins sign in after setting their password (HealthNet app).
MAIN_APP_URL=

# --------------------------------------------------
# Marketing Intelligence - Shared
# --------------------------------------------------
