# -----------------------------------------------------------------------------
# CosmicForge Mail (all live capabilities default OFF; never commit secrets)
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_SENDING_ENABLED=false
MAIL_RECEIVING_ENABLED=false
MAIL_MARKETING_ENABLED=false
MAIL_WORKER_ENABLED=false
MAIL_WORKER_QUEUES=OUTBOUND,INBOUND,EVENTS
MAIL_PROVIDER=resend
# Comma-separated sender domains allowed for external (provider) delivery.
# REQUIRED for any external send: empty = all external delivery is denied.
# Domain registration is also limited to these domains, and is refused while
# the list is empty (fail closed). Staging/production require it whenever
# sending or receiving is enabled.
MAIL_DOMAIN_ALLOWLIST=
# Addresses on our domains that another system sends from directly through
# the provider (comma list), e.g. no-reply@karryam.com for the KarryGo
# Notification Service. CA never sends as them, discards inbound mail to them
# and does not store provider events for mail they sent.
MAIL_RESERVED_SENDER_ADDRESSES=
# One Resend account/key serves staging and production. Comma list of approved
# external test recipients ("qa@x.com", "@x.com" or "x.com"); when set, every
# external send to anyone else is refused before the provider is called.
# Required on staging when MAIL_SENDING_ENABLED=true; leave empty in production.
MAIL_TEST_RECIPIENT_ALLOWLIST=
# The deployment the single Resend webhook points at (staging|production).
# Only that deployment accepts email.received and runs inbound reconciliation;
# the other answers 503 and defers. Set the SAME value in both environments and
# change both at a webhook cutover. Required on staging/production to receive.
MAIL_INBOUND_ACTIVE_ENVIRONMENT=
# Provider-side domain registration (POST /domains) and verification
# triggers from the Mail admin API (Mail admin + MFA step-up, audited). Never
# changes DNS. Reading verification status does not need it.
MAIL_PROVIDER_DOMAIN_MANAGEMENT_ENABLED=false
# Optional marker naming the environment the provider account/API key belongs
# to (staging|production|...). When set it must equal the deployment
# environment (MAIL_DEPLOYMENT_ENV); RESEND_API_KEY_ENVIRONMENT is an alias.
# Staging/production also refuse MAIL_PROVIDER=fake and need
# RESEND_WEBHOOK_SECRET when sending or receiving is enabled.
MAIL_PROVIDER_ENVIRONMENT_TAG=
# Brands that must never send through Resend (no BAA; spec §19.7). Slug
# prefixes, comma-separated. Leave the approval flag false unless a reviewed
# owner decision and an approved provider contract exist.
MAIL_RESTRICTED_HEALTH_ORGANIZATIONS=healthnet
MAIL_RESTRICTED_HEALTH_PROVIDER_APPROVED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Webhook secret rotation grace period: set the old secret here while Resend
# switches to the new one, then clear it (spec §19.3).
RESEND_WEBHOOK_SECRET_PREVIOUS=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_MS=15000
# Client-side pacing per worker process (Resend default limit: 10 requests/s
# per team). 0 disables pacing; provider 429s always defer jobs durably.
RESEND_REQUESTS_PER_SECOND=8
# Private-mail session hardening (section 17.1). When true, an enabled Mail is
# not ready unless HQ sessions use httpOnly cookies (AUTH_SESSION_MODE=cookie,
# or dual with MAIL_SESSION_ALLOW_DUAL=true). Default: true in production only.
MAIL_REQUIRE_HARDENED_SESSION=
MAIL_SESSION_ALLOW_DUAL=false
RESEND_ATTACHMENT_HOST_ALLOWLIST=resend.com,resend.app,resend-attachments.com
MAIL_WEBHOOK_TOLERANCE_SECONDS=300
MAIL_WEBHOOK_MAX_BODY_BYTES=262144
# reject | quarantine (unknown recipients are never auto-provisioned)
MAIL_UNKNOWN_RECIPIENT_POLICY=reject
# GAP 8 (spec 11.8) mixed internal/external recipients, see
# docs/cosmicforge-mail-mixed-recipients.md. external-only (default): the
# provider only gets external recipients, so external recipients do not see
# internal To/Cc. full-headers: the provider gets the full visible To/Cc and
# delivers to internal addresses too (echoes are dropped by the signed
# X-CosmicForge-Origin header / Message-ID). Enable full-headers ONLY after the
# receiving cutover (our MX -> Resend) and product/security approval; before it
# the legacy mail system receives duplicate copies. Refused without a key.
MAIL_MIXED_RECIPIENT_MODE=external-only
# full-headers is also refused until the receiving cutover is confirmed
# (explicit second switch; keep false until our MX points at Resend).
MAIL_RECEIVING_CUTOVER_CONFIRMED=false
# >= 32 random chars; optional with MAIL_KMS_PROVIDER=env (derived from
# MAIL_ENCRYPTION_KEYS), required with aws-kms for full-headers.
MAIL_ORIGIN_HEADER_SECRET=
# development | test | staging | production. Undeclared + NODE_ENV=production
# is treated as production (strictest rules). Staging and production must use
# separate buckets/KMS keys whose names carry the environment marker
# (staging|stg vs production|prod). See docs/cosmicforge-mail-storage-kms.md.
MAIL_DEPLOYMENT_ENV=
# unavailable | filesystem (staging pilot only) | s3 (required in production)
MAIL_STORAGE_PROVIDER=unavailable
MAIL_STORAGE_LOCAL_DIR=
# S3-compatible private object storage (AWS S3 / R2 / MinIO / Contabo).
# Credentials come from the environment's own secret store; never share them
# between staging and production.
MAIL_S3_ENDPOINT=
MAIL_S3_REGION=us-east-1
MAIL_S3_BUCKET=
MAIL_S3_PREFIX=mail
MAIL_S3_FORCE_PATH_STYLE=true
MAIL_S3_ACCESS_KEY_ID=
MAIL_S3_SECRET_ACCESS_KEY=
MAIL_S3_SESSION_TOKEN=
# "" | AES256 | AWS:KMS (required in production)
MAIL_S3_SSE=
MAIL_S3_SSE_KMS_KEY_ID=
MAIL_S3_SEND_PRIVATE_ACL=true
MAIL_S3_CONDITIONAL_WRITES=true
MAIL_S3_CHECKSUM_HEADER=true
MAIL_S3_TIMEOUT_MS=10000
MAIL_S3_MAX_RETRIES=2
# Health = HEAD bucket + put/get/delete canary under <prefix>/health/ (cached).
# Set false for Object Lock buckets (HEAD only).
MAIL_S3_HEALTH_CANARY=true
MAIL_S3_HEALTH_CACHE_MS=60000
# env (raw keys, non-production only) | aws-kms (KMS-wrapped data keys)
MAIL_KMS_PROVIDER=env
MAIL_KMS_REGION=
MAIL_KMS_ENDPOINT=
MAIL_KMS_KEY_ID=
# Required when MAIL_KMS_KEY_ID is a key ARN/id rather than an alias.
MAIL_KMS_KEY_ENVIRONMENT=
MAIL_KMS_ACCESS_KEY_ID=
MAIL_KMS_SECRET_ACCESS_KEY=
# Mail keyring. env: "v1:<base64 32 bytes>,v2:..."; aws-kms: "v2:kms:<CiphertextBlob>" entries
# from `npm run mail:kms:generate-data-key -- --version=v2`. Keep retired versions until
# `npm run mail:keys:rotate -- --apply` reports remaining=0.
MAIL_ENCRYPTION_KEYS=
MAIL_ENCRYPTION_ACTIVE_KEY=
# Attachment scanning: unavailable (fail closed, quarantine) | clamd | test-signature (non-production only)
MAIL_SCANNER_PROVIDER=unavailable
MAIL_CLAMD_HOST=127.0.0.1
MAIL_CLAMD_PORT=3310
MAIL_SCANNER_TIMEOUT_MS=15000
MAIL_SCANNER_CONNECT_TIMEOUT_MS=3000
# Must not exceed clamd StreamMaxLength; larger files are quarantined unscanned.
MAIL_SCANNER_MAX_STREAM_BYTES=26214400
MAIL_ATTACHMENT_MAX_BYTES=10485760
MAIL_MESSAGE_MAX_BYTES=26214400
MAIL_MAX_ATTACHMENTS=10
MAIL_MAX_RECIPIENTS=50
MAIL_BODY_MAX_BYTES=1048576
MAIL_SENDS_PER_MINUTE_PER_USER=20
MAIL_MARKETING_CSV_MAX_ROWS=5000
# Mail search covers subject, sender, non-BCC recipients, labels and dates;
# body search is the opt-in keyed index below. Bodies, previews and notes are
# never stored in plaintext; the legacy MAIL_SEARCH_INDEX_BODIES (plaintext
# indexing) is ignored and reported as refused in /mail/status.
MAIL_ARCHIVE_RAW_MIME=false
# Original headers are archived encrypted once migration 35 is applied.
MAIL_ARCHIVE_HEADERS=true
MAIL_ARCHIVE_RAW_MAX_BYTES=31457280
# Body search: keyed blind index (no plaintext). Off until approved; needs a
# dedicated key ring "s1:<base64 32 bytes>" kept in the secret manager.
# See docs/cosmicforge-mail-body-search.md for the leakage trade-off.
MAIL_BODY_SEARCH_ENABLED=false
MAIL_SEARCH_INDEX_KEYS=
MAIL_SEARCH_INDEX_ACTIVE_KEY=
# Inbound sender authentication: monitor | warn (default) | quarantine.
MAIL_INBOUND_AUTH_POLICY=warn
MAIL_INBOUND_QUARANTINE_INTERNAL_SPOOF=true
# Comma-separated authserv-ids of OUR receiving MTA whose
# Authentication-Results headers may be trusted (empty: provider results only).
MAIL_TRUSTED_AUTHSERV_IDS=
# Forwarding: external targets only to these domains (empty: none) and only
# after a mail administrator approves with two-factor confirmation.
MAIL_FORWARDING_EXTERNAL_ALLOWED_DOMAINS=
MAIL_FORWARDING_MAX_RULES=3
MAIL_FORWARDING_MAX_HOPS=3
# Mailbox storage quota (MB) and over-quota policy: accept (deliver + alert) | reject.
MAIL_MAILBOX_STORAGE_QUOTA_MB=10240
MAIL_MAILBOX_STORAGE_WARN_PERCENT=90
MAIL_OVER_QUOTA_POLICY=accept
# Campaign reply attribution window (days after sending).
MAIL_MARKETING_REPLY_WINDOW_DAYS=30
# Extra operational alert thresholds.
MAIL_ALERT_EXPORTS_PER_ACTOR_HOUR=50
MAIL_ALERT_SCANNER_FAILURES_24H=1
MAIL_ALERT_SEARCH_STALE_SECONDS=3600
MAIL_RECONCILIATION_ENABLED=false
# Inbound reconciliation (needs receiving + an INBOUND worker): lists received
# emails at the provider and processes any whose webhook never arrived.
# MAIL_INBOUND_RECONCILE_INTERVAL_SECONDS=900
# MAIL_INBOUND_RECONCILE_LOOKBACK_HOURS=24
# MAIL_INBOUND_RECONCILE_GRACE_SECONDS=600
# MAIL_INBOUND_RECONCILE_MAX_PAGES=5
# Resend keeps idempotency keys 24h; ambiguous sends older than this become OUTCOME_UNKNOWN (max 23)
MAIL_PROVIDER_IDEMPOTENCY_WINDOW_HOURS=23
MAIL_WORKER_POLL_INTERVAL_MS=2000
MAIL_WORKER_CONCURRENCY=4
# Clamped up to RESEND_TIMEOUT_MS/1000 + 30 (a lease must outlive one provider call).
MAIL_WORKER_LEASE_SECONDS=120
MAIL_WORKER_MAX_ATTEMPTS=6
# Graceful shutdown: how long the worker waits for in-flight jobs before exiting
# (jobs still running are recovered by lease expiry).
MAIL_WORKER_DRAIN_TIMEOUT_MS=30000
MAIL_STEP_UP_TTL_SECONDS=300

# ── CosmicForge Mail M7: broadcasts and automation (all OFF by default) ──
# Each live capability needs MAIL_ENABLED + MAIL_MARKETING_ENABLED and its own flag.
MAIL_BROADCAST_DISPATCH_ENABLED=false
MAIL_AUTOMATION_ENABLED=false
MAIL_MARKETING_CONFIRMATION_EMAILS_ENABLED=false
# Campaign test sends ([TEST] copy to active staff addresses only).
MAIL_MARKETING_TEST_SENDS_ENABLED=false
MAIL_MARKETING_TEST_SEND_MAX_RECIPIENTS=5
MAIL_MARKETING_TEST_SENDS_PER_HOUR=10
# ---- final gap 7: deliverability preflight (reporting only; enables nothing).
# Reputation window/sample and thresholds in basis points (200 = 2%).
MAIL_MARKETING_REPUTATION_WINDOW_DAYS=30
MAIL_MARKETING_REPUTATION_MIN_SAMPLE=100
MAIL_MARKETING_BOUNCE_WARN_BPS=200
MAIL_MARKETING_BOUNCE_BLOCK_BPS=500
MAIL_MARKETING_COMPLAINT_WARN_BPS=10
MAIL_MARKETING_COMPLAINT_BLOCK_BPS=30
# Provider click tracking is not readable through the adapters. Declare it
# (on|off) after checking the provider dashboard; unset = UNKNOWN. "on" blocks
# TRANSACTIONAL_SECURITY templates (tracking would rewrite their links).
# MAIL_MARKETING_PROVIDER_CLICK_TRACKING=
# Extra link domains allowed in TRANSACTIONAL_SECURITY templates (comma list;
# the brand's own mail domains are always allowed).
# MAIL_MARKETING_SECURITY_LINK_DOMAINS=
MAIL_MARKETING_PREFLIGHT_PROVIDER_TIMEOUT_MS=5000
# Queues served by a worker process. Run MARKETING as its own single replica.
# MAIL_WORKER_QUEUES=outbound,inbound,events
# Per-brand Resend marketing account keys (contacts/unsubscribes are account-global):
# RESEND_MARKETING_API_KEY__<BRAND_SLUG>=re_...
# Per-brand marketing webhook signing secrets (/api/mail/v1/webhooks/resend/brand/<slug>):
# RESEND_WEBHOOK_SECRET__<BRAND_SLUG>=whsec_...
# During a brand secret rotation, the old secret (accepted until cleared):
# RESEND_WEBHOOK_SECRET__<BRAND_SLUG>_PREVIOUS=whsec_...
# A shared marketing key is used only with an explicit decision:
MAIL_BROADCAST_ALLOW_SHARED_PROVIDER_ACCOUNT=false
# RESEND_MARKETING_API_KEY=
MAIL_BROADCAST_MAX_RECIPIENTS=1000
MAIL_BROADCAST_PROVIDER_RPS=5
MAIL_BROADCAST_SYNC_BATCH=100
MAIL_CAMPAIGN_APPROVAL_TTL_DAYS=14
MAIL_BROADCAST_MIN_LEAD_SECONDS=300
MAIL_BROADCAST_RECONCILE_SECONDS=60
MAIL_BROADCAST_RECONCILE_MAX_HOURS=48
# Public API origin for unsubscribe / confirmation links, and the HMAC secret (>= 32 chars).
# MAIL_PUBLIC_API_URL=https://admin-api.example.com
# MAIL_MARKETING_UNSUBSCRIBE_SECRET=
# MAIL_MARKETING_UNSUBSCRIBE_PREVIOUS_SECRET=
# Emergency stop: blocks provider calls, keeps every queued record.
MAIL_EMERGENCY_STOP_MARKETING=false
MAIL_EMERGENCY_STOP_ALL=false

# ---- CosmicForge Mail M8: product integrations (all OFF by default) ----
# Product -> HQ event ingestion at POST /api/mail/v1/integrations/v1/events.
MAIL_INTEGRATIONS_ENABLED=false
# Service identities and HMAC secrets, Karryam serviceauth format:
# MAIL_INTEGRATION_SERVICE_SECRETS=karryam-notification-service=<secret>,healthnet-ops=<secret>
# HMAC key for recipient hashing (>= 32 chars). Recipients are never stored in plaintext.
# MAIL_INTEGRATION_HASH_SECRET=
MAIL_INTEGRATION_MAX_SKEW_SECONDS=300
MAIL_INTEGRATION_RATE_PER_MINUTE=600
MAIL_INTEGRATION_MAX_BODY_BYTES=16384
# Karryam native notifications.Request shape (temporary compat shim, OFF when
# empty). Comma-separated service identities; only honoured for the Karryam
# integration. See docs/cosmicforge-mail-karryam-handoff.md (sunset plan).
MAIL_INTEGRATION_KARRYAM_COMPAT_SERVICES=

# ---- CosmicForge Mail M9: operations ----
# Retention: dry runs are always available to mail admins; EXECUTION
# (permanent removal) is off until explicitly enabled here.
MAIL_RETENTION_EXECUTION_ENABLED=false
MAIL_RETENTION_BATCH_SIZE=100
MAIL_RETENTION_DRY_RUN_VALID_HOURS=24
# System retention periods (days). Unset = never purged. Set only from an
# approved retention schedule; no defaults are provided.
# MAIL_RETENTION_WEBHOOK_PAYLOAD_DAYS=
# MAIL_RETENTION_INTEGRATION_EVENT_DAYS=
# MAIL_RETENTION_PRODUCT_DELIVERY_EVENT_DAYS=
# Final gap 5: durable storage deletion queue (migration 37). Failed object
# deletions retry with exponential backoff + full jitter, then go DEAD for
# manual review in Mail operations (requeue needs a 2FA step-up).
MAIL_STORAGE_DELETION_MAX_ATTEMPTS=12
MAIL_STORAGE_DELETION_BACKOFF_BASE_SECONDS=30
MAIL_STORAGE_DELETION_BACKOFF_CAP_SECONDS=21600
MAIL_STORAGE_DELETION_BATCH_SIZE=100
MAIL_STORAGE_DELETION_LEASE_SECONDS=300
MAIL_STORAGE_DELETION_INTERVAL_SECONDS=300
# Ops alert evaluation (in-app notifications to mail admins only).
MAIL_OPS_ALERTS_ENABLED=true
MAIL_OPS_EVALUATE_SECONDS=300
# Prometheus scrape token (>= 32 chars). Unset = /api/mail/v1/ops/metrics returns 404.
# MAIL_METRICS_TOKEN=
# Initial alert thresholds (tune from pilot data):
# MAIL_ALERT_QUEUE_OLDEST_SECONDS=900
# MAIL_ALERT_DEAD_LETTERS_24H=1
# MAIL_ALERT_WEBHOOK_BACKLOG_SECONDS=600
# MAIL_ALERT_SCAN_BACKLOG_SECONDS=1800
# MAIL_ALERT_OUTCOME_UNKNOWN_24H=1
# MAIL_ALERT_BOUNCE_RATE_PERCENT=5
# MAIL_ALERT_COMPLAINT_RATE_PER_THOUSAND=1
# MAIL_ALERT_MIN_SAMPLE=100
# MAIL_ALERT_INTEGRATION_REJECTIONS_1H=20
# MAIL_ALERT_PROVIDER_RETRYING=20
# MAIL_ALERT_WEBHOOK_LAG_SECONDS=300
# Optional operator-provided cost rates from YOUR contract (no defaults):
# MAIL_COST_RATES={"currency":"USD","perThousand":{"STAFF_MAIL":0,"MARKETING_BROADCAST":0}}
# ---- GAP 2/3 (final gap closure): provider re-subscription, quota, pricing ----
# Re-subscribing a contact at Resend after a verified double opt-in uses
# PATCH /contacts/{id} {"unsubscribed": false}. Resend documents only
# `unsubscribed: true`; `false` is NOT documented. Keep false unless Resend
# support has confirmed it for your account. While false, approved
# re-subscriptions become UNSUPPORTED: the operator re-adds the contact via the
# Resend dashboard / support and then confirms it in Email Studio (step-up).
MAIL_MARKETING_PROVIDER_RESUBSCRIBE_ENABLED=false
# Optional account-plan sending limits (emails). Unset = UNKNOWN (no
# "remaining" figure is shown). Used quota is read from Resend response
# headers (x-resend-monthly-quota, x-resend-daily-quota); there is no billing
# API, so spend is always an estimate from approved pricing rows.
# MAIL_PROVIDER_MONTHLY_LIMIT=
# MAIL_PROVIDER_DAILY_LIMIT=
# Per-account limits for marketing keys (same semantics): a brand's own key
# (RESEND_MARKETING_API_KEY__<SLUG>) and the shared marketing key
# (RESEND_MARKETING_API_KEY with MAIL_BROADCAST_ALLOW_SHARED_PROVIDER_ACCOUNT).
# MAIL_PROVIDER_MONTHLY_LIMIT__<SLUG>=
# MAIL_PROVIDER_DAILY_LIMIT__<SLUG>=
# MAIL_PROVIDER_MONTHLY_LIMIT__MARKETING_SHARED=
# MAIL_PROVIDER_DAILY_LIMIT__MARKETING_SHARED=

# ---- CosmicForge Mail M10: rollout ----
# Database rollout rules (ALLOW/DENY per capability and scope). Unset = ON in
# production (deny unless allowed), OFF elsewhere. Set true in staging to
# rehearse the pilot exactly as production will run it.
# MAIL_ROLLOUT_ENFORCED=
