SOCIAL_MEDIA_IMAGE_MAX_BYTES=10485760
SOCIAL_MEDIA_VIDEO_MAX_BYTES=31457280
SOCIAL_MEDIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
SOCIAL_MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm
