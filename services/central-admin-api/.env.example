# --------------------------------------------------
# Core
# --------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/cosmicforge_admin
ADMIN_JWT_SECRET=
MAIN_BACKEND_JWT_SECRET=
MAIN_BACKEND_URL=
CORS_ORIGINS=http://localhost:3000

# ── HQ sessions (docs/hq-auth-sessions-and-mfa.md) ─────────────────────────
# legacy (default, unchanged contract) | dual (cookies + body token) | cookie
AUTH_SESSION_MODE=legacy
# none for cross-site frontend/API (forces Secure); lax when same-site
AUTH_COOKIE_SAMESITE=
AUTH_COOKIE_SECURE=
# Optional parent domain, e.g. .cosmiforgegroup.cloud (disables the __Host- prefix)
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=720
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=168
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_MAX_SESSIONS_PER_USER=10
# Optional; defaults to a key derived from ADMIN_JWT_SECRET
AUTH_CSRF_SECRET=

# ── HQ MFA ──────────────────────────────────────────────────────────────────
# Keyring for encrypting TOTP secrets: "k1:<base64 32 bytes>,k2:<base64 32 bytes>"
# MFA enrollment fails closed (503) when unset. Store in the secret manager.
AUTH_MFA_ENCRYPTION_KEYS=
AUTH_MFA_ENCRYPTION_ACTIVE_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --------------------------------------------------
# Admin Google OAuth
# --------------------------------------------------
# Leave all three values blank to disable optional Google login locally and in CI.
# Provide all three together to enable Google login. Staging/production callbacks
# must use an exact HTTPS URL with no wildcard or request-derived redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --------------------------------------------------
# Main application database
# --------------------------------------------------
MAIN_DB_ENV=dev
MAIN_DATABASE_URL_DEV=
MAIN_DATABASE_URL_PROD=

# --------------------------------------------------
# Email
# --------------------------------------------------
CPANEL_EMAIL_HOST=
CPANEL_EMAIL_PORT=
CPANEL_EMAIL_SECURE=
CPANEL_EMAIL_USER=
CPANEL_EMAIL_PASS=
CPANEL_EMAIL_FROM=

# --------------------------------------------------
# Marketing Intelligence - Shared
# --------------------------------------------------
# Phase 2 deployment kill switch. Phase 1 campaign sync remains independent.
MARKETING_INTELLIGENCE_PHASE2_ENABLED=false
MARKETING_LIVE_VALIDATION_ENABLED=false
MARKETING_INTELLIGENCE_SYNC_ENABLED=false
MARKETING_INTELLIGENCE_BOOTSTRAP_CONNECTIONS=false
MARKETING_INTELLIGENCE_CRON=0 */6 * * *
MARKETING_INTELLIGENCE_LOOKBACK_DAYS=3
MARKETING_INTELLIGENCE_INITIAL_LOOKBACK_DAYS=30
MARKETING_INTELLIGENCE_SYNC_TIMEZONE=UTC
MARKETING_INTELLIGENCE_LOCK_TTL_SECONDS=1800
MARKETING_RECOMMENDATION_SCHEDULER_ENABLED=false
MARKETING_RECOMMENDATION_CRON=15 */6 * * *
MARKETING_RECOMMENDATION_TIMEZONE=UTC
MARKETING_ALERT_HEALTH_SCHEDULER_ENABLED=false
MARKETING_ALERT_HEALTH_CRON=5 * * * *
MARKETING_ALERT_HEALTH_TIMEZONE=UTC
MARKETING_ALERT_PERFORMANCE_SCHEDULER_ENABLED=false
MARKETING_ALERT_PERFORMANCE_CRON=30 2 * * *
MARKETING_ALERT_PERFORMANCE_TIMEZONE=UTC
# Legacy compatibility: used only when the corresponding specific key is absent.
MARKETING_ALERT_SCHEDULER_ENABLED=false
MARKETING_ALERT_CRON=30 2 * * *
MARKETING_ALERT_TIMEZONE=UTC
MARKETING_CREATIVE_SYNC_SCHEDULER_ENABLED=false
MARKETING_CREATIVE_SYNC_CRON=30 */6 * * *
MARKETING_CREATIVE_SYNC_TIMEZONE=UTC
MARKETING_CREATIVE_SCORE_SCHEDULER_ENABLED=false
MARKETING_CREATIVE_SCORE_CRON=0 1 * * *
MARKETING_CREATIVE_SCORE_TIMEZONE=UTC
MARKETING_RECOMMENDATION_EXPIRY_SCHEDULER_ENABLED=false
MARKETING_RECOMMENDATION_EXPIRY_CRON=30 2 * * *
MARKETING_RECOMMENDATION_EXPIRY_TIMEZONE=UTC
MARKETING_FULL_EVALUATION_SCHEDULER_ENABLED=false
MARKETING_FULL_EVALUATION_CRON=0 3 * * *
MARKETING_FULL_EVALUATION_TIMEZONE=UTC
MARKETING_ATTRIBUTION_WINDOW_DAYS=30
MARKETING_PROVIDER_TIMEOUT_MS=30000
MARKETING_PROVIDER_MAX_RETRIES=3
MARKETING_CREDENTIALS_ENCRYPTION_KEY=
MARKETING_OAUTH_STATE_TTL_SECONDS=600
MARKETING_INTELLIGENCE_INTERNAL_SERVICE_KEY=
ADMIN_BACKEND_PUBLIC_URL=
ADMIN_FRONTEND_PUBLIC_URL=
MARKETING_OAUTH_SUCCESS_REDIRECT_URL=
MARKETING_OAUTH_FAILURE_REDIRECT_URL=

# --------------------------------------------------
# Advertising Execution - Phase 3 safety gates
# All provider writes remain disabled until durable Section 9 configuration.
# --------------------------------------------------
MARKETING_AD_EXECUTION_ENABLED=false
MARKETING_AD_EXECUTION_DRY_RUN=true
MARKETING_AD_EXECUTION_WORKER_ENABLED=false
MARKETING_AD_RECONCILIATION_WORKER_ENABLED=false
MARKETING_AD_EXECUTION_GOOGLE_ADS_ENABLED=false
MARKETING_AD_EXECUTION_META_ENABLED=false
MARKETING_AD_EXECUTION_TIKTOK_ENABLED=false
MARKETING_AD_EXECUTION_LINKEDIN_ENABLED=false
MARKETING_AD_EXECUTION_X_ENABLED=false
MARKETING_AD_EXECUTION_GOOGLE_ADS_API_VERSION=
MARKETING_AD_EXECUTION_META_API_VERSION=
MARKETING_AD_EXECUTION_TIKTOK_API_VERSION=
MARKETING_AD_EXECUTION_LINKEDIN_API_VERSION=
MARKETING_AD_EXECUTION_X_API_VERSION=

# --------------------------------------------------
# Advertising Execution - Section 29.2 live validation (never set in CI)
# Live commands (npm run live:read:* / live:validate:*) fail closed unless
# every value below is explicitly configured. Leave all of these empty.
# --------------------------------------------------
MARKETING_AD_EXECUTION_LIVE_TEST_CONFIRMED=
MARKETING_AD_EXECUTION_LIVE_TEST_CONFIRMATION=
MARKETING_AD_EXECUTION_LIVE_TEST_ACCOUNT_ALLOWLIST=
MARKETING_AD_EXECUTION_LIVE_TEST_ACCOUNT_DENYLIST=
MARKETING_AD_EXECUTION_LIVE_TEST_MAX_BUDGET_MINOR=
MARKETING_AD_EXECUTION_LIVE_TEST_CURRENCY=
MARKETING_AD_EXECUTION_LIVE_TEST_DESTINATION_ALLOWLIST=

