# Social Operations - Media and monitoring
# --------------------------------------------------
SOCIAL_MEDIA_STORAGE_PROVIDER=local
SOCIAL_LOCAL_MEDIA_STORAGE_DIR=
SOCIAL_CLOUDINARY_FOLDER_PREFIX=
SOCIAL_MEDIA_UPLOAD_TIMEOUT_MS=10000
SOCIAL_MEDIA_IMAGE_MAX_BYTES=10485760
SOCIAL_MEDIA_VIDEO_MAX_BYTES=31457280
SOCIAL_MEDIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
SOCIAL_MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm
SOCIAL_REMOTE_MEDIA_ALLOWED_HOSTS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_APP_BASE_URL=
SOCIAL_API_BASE_URL=
SOCIAL_ALERT_WEBHOOK_URL=
SOCIAL_MONITORING_API_KEY=

# -----------------------------------------------------------------------------
# CosmicForge Mail (all live capabilities default OFF; never commit secrets)
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_SENDING_ENABLED=false
MAIL_RECEIVING_ENABLED=false
MAIL_MARKETING_ENABLED=false
MAIL_WORKER_ENABLED=false
MAIL_WORKER_QUEUES=OUTBOUND,INBOUND,EVENTS
MAIL_PROVIDER=resend
# Comma-separated domains allowed for registration/sending (empty = no extra restriction)
MAIL_DOMAIN_ALLOWLIST=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_MS=15000
RESEND_ATTACHMENT_HOST_ALLOWLIST=resend.com,resend.app,resend-attachments.com
MAIL_WEBHOOK_TOLERANCE_SECONDS=300
MAIL_WEBHOOK_MAX_BODY_BYTES=262144
# reject | quarantine (unknown recipients are never auto-provisioned)
MAIL_UNKNOWN_RECIPIENT_POLICY=reject
# Private storage: unavailable (fail closed) | filesystem | memory (non-production only)
MAIL_STORAGE_PROVIDER=unavailable
MAIL_STORAGE_LOCAL_DIR=
# Mail keyring: "v1:<base64 32 bytes>,v2:<base64 32 bytes>" (KMS-managed in production)
MAIL_ENCRYPTION_KEYS=
MAIL_ENCRYPTION_ACTIVE_KEY=
# Attachment scanning: unavailable (fail closed, quarantine) | clamd | test-signature (non-production only)
MAIL_SCANNER_PROVIDER=unavailable
MAIL_CLAMD_HOST=127.0.0.1
MAIL_CLAMD_PORT=3310
MAIL_SCANNER_TIMEOUT_MS=15000
MAIL_ATTACHMENT_MAX_BYTES=10485760
MAIL_MESSAGE_MAX_BYTES=26214400
MAIL_MAX_ATTACHMENTS=10
MAIL_MAX_RECIPIENTS=50
MAIL_BODY_MAX_BYTES=1048576
MAIL_SENDS_PER_MINUTE_PER_USER=20
MAIL_MARKETING_CSV_MAX_ROWS=5000
MAIL_SEARCH_INDEX_BODIES=true
MAIL_ARCHIVE_RAW_MIME=false
MAIL_RECONCILIATION_ENABLED=false
# Resend keeps idempotency keys 24h; ambiguous sends older than this become OUTCOME_UNKNOWN (max 23)
MAIL_PROVIDER_IDEMPOTENCY_WINDOW_HOURS=23
MAIL_WORKER_POLL_INTERVAL_MS=2000
MAIL_WORKER_CONCURRENCY=4
MAIL_WORKER_LEASE_SECONDS=120
MAIL_WORKER_MAX_ATTEMPTS=6
MAIL_STEP_UP_TTL_SECONDS=300
