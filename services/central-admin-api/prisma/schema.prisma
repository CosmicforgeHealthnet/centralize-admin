  sentByAdminUserId  String?              @map("sent_by_admin_user_id")
  envelopeRecipient  String?              @map("envelope_recipient") @db.VarChar(320)
  hasAttachments     Boolean              @default(false) @map("has_attachments")
  sizeBytes          Int                  @default(0) @map("size_bytes")
  contentObjectKey   String?              @map("content_object_key") @db.VarChar(512)
  contentSha256      String?              @map("content_sha256") @db.Char(64)
  rawMimeObjectKey   String?              @map("raw_mime_object_key") @db.VarChar(512)
  // Metadata only (subject, sender, non-BCC recipients). Never message bodies.
  metadataSearchText String               @default("") @map("metadata_search_text")
  providerMessageId  String?              @map("provider_message_id") @db.VarChar(255)
  idempotencyKey     String?              @unique(map: "UQ_mail_messages_idempotency_key") @map("idempotency_key") @db.VarChar(128)
  authResults        Json?                @map("auth_results")
  spamVerdict        String?              @map("spam_verdict") @db.VarChar(32)
  quarantineReason   String?              @map("quarantine_reason") @db.VarChar(255)
  lastStatusAt       DateTime?            @map("last_status_at") @db.Timestamptz(6)
  sentAt             DateTime?            @map("sent_at") @db.Timestamptz(6)
  receivedAt         DateTime?            @map("received_at") @db.Timestamptz(6)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mailbox        MailMailbox            @relation(fields: [mailboxId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_mail_messages_mailbox")
  thread         MailThread             @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_mail_messages_thread")
  recipients     MailMessageRecipient[]
  attachments    MailAttachment[]
  deliveryEvents MailDeliveryEvent[]
  outboxJobs     MailOutboxJob[]

  @@unique([mailboxId, rfcMessageId], map: "UQ_mail_messages_mailbox_rfc_id")
  @@index([threadId, createdAt], map: "IDX_mail_messages_thread_created")
  @@index([mailboxId, createdAt(sort: Desc)], map: "IDX_mail_messages_mailbox_created")
  @@index([providerMessageId], map: "IDX_mail_messages_provider_message")
  @@index([mailboxId, rfcMessageId], map: "IDX_mail_messages_mailbox_rfc")
  @@map("mail_messages")
}

