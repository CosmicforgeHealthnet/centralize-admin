// Second login step: proves the password (or Google) step succeeded. Single
// use, short-lived, attempt-limited; only a hash of the token is stored.
model AdminMfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique(map: "UQ_admin_mfa_challenges_token") @map("token_hash") @db.Char(64)
  authMethod  String    @map("auth_method") @db.VarChar(32)
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)

  @@index([adminUserId], map: "IDX_admin_mfa_challenges_user")
  @@map("admin_mfa_challenges")
}

// Session/MFA security events. Kept out of admin_audit_logs so no new
// AuditAction enum values are needed (pre-migration code never writes here).
model AdminAuthEvent {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @map("admin_user_id")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String     @db.VarChar(64)
  targetType  String?    @map("target_type") @db.VarChar(64)
  targetId    String?    @map("target_id") @db.VarChar(128)
  metadata    Json?
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  userAgent   String?    @map("user_agent") @db.VarChar(512)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([adminUserId, createdAt], map: "IDX_admin_auth_events_user_time")
  @@index([action, createdAt], map: "IDX_admin_auth_events_action_time")
  @@map("admin_auth_events")
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("admin_refresh_tokens")
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetId    String?
  targetType  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@map("admin_audit_logs")
}

// -----------------------------------------------------------------------------
// SECTION-LEVEL PERMISSIONS (Addendum 2)
// -----------------------------------------------------------------------------

// One row = one person granted access to one specific section of one module,
// independent of their home Department. Home role templates are just a
// default starter set of these grants, applied at account creation.
model AdminSectionGrant {
  id          String            @id @default(uuid())
  adminUserId String
  adminUser   AdminUser         @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  module      String // e.g. "hrm", "finance", "verification"
  section     String // e.g. "accounts", "payroll", "doctors"  use "*" for whole-module
  mode        SectionAccessMode
  grantedBy   String // id of the account that issued the grant
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  revokedAt   DateTime?

  @@index([adminUserId])
  @@index([module, section])
  @@map("admin_section_grants")
}

// -----------------------------------------------------------------------------
// PROFILE  Social Links, Education, Documents, Performance Notes, Reports
// -----------------------------------------------------------------------------

model AdminSocialLink {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  platform    String
  username    String
  createdAt   DateTime  @default(now())

  @@map("admin_social_links")
}

model AdminEducation {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  degreeTitle String
  institution String
  from        String?
  to          String?
  createdAt   DateTime  @default(now())

  @@map("admin_educations")
}

// Uploaded by SUPER/EXECUTIVE on behalf of the employee. Employee is read-only.
model AdminDocument {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  name         String
  title        String? // display title separate from the raw filename
  type         String // "pdf", "docx", "jpg" etc.
  url          String // Cloudinary secure URL
  cloudinaryId String? // Cloudinary public_id  needed to delete the file
  uploadedBy   String // id of the SUPER/EXECUTIVE who uploaded it
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  @@map("admin_documents")
}

// Written BY a SUPER/EXECUTIVE ABOUT an employee. Employee is read-only.
model AdminPerformanceNote {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title        String
  type         String    @default("docx")
  url          String // Cloudinary secure URL
  cloudinaryId String?
  createdBy    String // id of the SUPER/EXECUTIVE who wrote it
  date         DateTime  @default(now())

  @@map("admin_performance_notes")
}

// Written BY the employee themselves (leave resumption, milestone, etc.)
// Text-based  no file upload.
model AdminReport {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title        String
  type         String?   @default("text")
  body         String?
  note         String?
  url          String?
  cloudinaryId String?
  createdBy    String
  date         DateTime  @default(now())

  @@map("admin_reports")
}

// -----------------------------------------------------------------------------
// WORK SECTION  Teams
// -----------------------------------------------------------------------------

model Team {
  id         String      @id @default(uuid())
  title      String
  department Department?
  createdBy  String // id of the SUPER/EXECUTIVE who created the team
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

// Join table: AdminUser  Team
model TeamMember {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  isTeamLead  Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  @@unique([teamId, adminUserId])
  @@map("team_members")
}

// -----------------------------------------------------------------------------
// WORK SECTION  Projects
// -----------------------------------------------------------------------------

model Project {
  id           String        @id @default(uuid())
  title        String
  description  String?
  assignedDate DateTime      @default(now())
  dueDate      DateTime
  teamId       String
  team         Team          @relation(fields: [teamId], references: [id])
  status       ProjectStatus @default(IN_PROGRESS)
  createdBy    String // id of the admin who created the project
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignees ProjectMember[]
  tasks     Task[]

  @@map("projects")
}

// Join table: AdminUser  Project (individual assignees beyond the whole team)
model ProjectMember {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([projectId, adminUserId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// WORK SECTION  Tasks
// -----------------------------------------------------------------------------

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  assignedDate DateTime   @default(now())
  dueDate      DateTime
  projectId    String? // optional  tasks can exist outside a project
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignerId   String
  assigner     AdminUser  @relation("TaskAssigner", fields: [assignerId], references: [id])
  assigneeId   String?
  assignee     AdminUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  status       TaskStatus @default(IN_PROGRESS)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  socialEscalations        SocialEscalation[]
  marketingRecommendations marketing_recommendations[]

  @@map("tasks")
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// HRM ATTENDANCE AND LEAVES
// -----------------------------------------------------------------------------

model AttendanceLog {
  id          String           @id @default(uuid())
  adminUserId String
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      AttendanceStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, date])
  @@index([adminUserId])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id             String             @id @default(uuid())
  adminUserId    String
  leaveType      LeaveType
  startDate      DateTime
  resumptionDate DateTime
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  attachmentUrl  String?
  attachmentName String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  adminUser  AdminUser  @relation("LeaveRequestEmployee", fields: [adminUserId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([status])
  @@index([startDate])
  @@index([reviewedById])
}

model LeaveBalance {
  id            String    @id @default(uuid())
  adminUserId   String
  leaveType     LeaveType
  year          Int
  availableDays Int       @default(0)
  usedDays      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, leaveType, year])
  @@index([adminUserId])
  @@index([year])
}

model Notification {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  icon        String // "alert" | "xcircle" | "settings" | "check" | "bell"
  title       String
  subtitle    String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  marketingAlerts marketing_alerts[]

  @@map("notifications")
}

// -----------------------------------------------------------------------------
// HRM PAYROLL
// -----------------------------------------------------------------------------

model PayrollRecord {
  id              String        @id @default(uuid())
  adminUserId     String
  month           Int
  year            Int
  totalSalary     Decimal       @default(0) @db.Decimal(15, 2)
  totalAllowance  Decimal       @default(0) @db.Decimal(15, 2)
  totalBonus      Decimal       @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(15, 2)
  grossPay        Decimal       @default(0) @db.Decimal(15, 2)
  netPay          Decimal       @default(0) @db.Decimal(15, 2)
  status          PayrollStatus @default(PENDING)
  paymentMethod   String?
  bankName        String?
  bankAccount     String?
  paymentDate     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser  AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payslips   Payslip[]
  deductions Deduction[]
  receipts   Receipt[]
  invoices   Invoice[]

  @@unique([adminUserId, month, year])
  @@index([adminUserId])
  @@index([month, year])
  @@index([status])
  @@map("payroll_records")
}

model Payslip {
  id              String    @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  month           Int
  year            Int
  basicSalary     Decimal   @default(0) @db.Decimal(15, 2)
  allowance       Decimal   @default(0) @db.Decimal(15, 2)
  bonus           Decimal   @default(0) @db.Decimal(15, 2)
  deductionsJson  Json?
  netPay          Decimal   @default(0) @db.Decimal(15, 2)
  paymentMethod   String?
  paymentDate     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("payslips")
}

model Deduction {
  id              String   @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  name            String
  amount          Decimal  @default(0) @db.Decimal(15, 2)
  month           Int
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("deductions")
}

model Receipt {
  id              String   @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  amount          Decimal  @default(0) @db.Decimal(15, 2)
  description     String?
  month           Int
  year            Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("receipts")
}

model Invoice {
  id              String        @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  amount          Decimal       @default(0) @db.Decimal(15, 2)
  description     String?
  dueDate         DateTime?
  status          InvoiceStatus @default(PENDING)
  month           Int
  year            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@index([status])
  @@map("invoices")
}

// -----------------------------------------------------------------------------
// HRM HIRING
// -----------------------------------------------------------------------------

model JobVacancy {
  id                String        @id @default(uuid())
  title             String
  department        Department?
  category          String?
  location          String?
  numberOfOpening   Int           @default(1)
  experienceLevel   String?
  salaryRange       String?
  benefitsAndBonus  String?
  jobDescription    String?
  responsibilities  String?
  requirements      String?
  hiringStages      Json?
  assignedRecruiter String?
  deadline          DateTime?
  status            VacancyStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applicants JobApplicant[]

  @@index([status])
  @@index([department])
  @@map("job_vacancies")
}

model JobApplicant {
  id              String         @id @default(uuid())
  vacancyId       String
  fullName        String
  email           String?
  phone           String?
  country         String?
  stage           ApplicantStage @default(SCREENING)
  via             String?
  applicationDate DateTime       @default(now())
  coverLetter     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vacancy     JobVacancy               @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  attachments JobApplicantAttachment[]

  @@index([vacancyId])
  @@index([stage])
  @@map("job_applicants")
}

model JobApplicantAttachment {
  id          String   @id @default(uuid())
  applicantId String
  url         String
  name        String?
  type        String?
  createdAt   DateTime @default(now())

  applicant JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("job_applicant_attachments")
}

// -----------------------------------------------------------------------------
// HRM PERFORMANCE  Events
// -----------------------------------------------------------------------------

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// -----------------------------------------------------------------------------
// COSMICFORGE MAIL (M1-M6)
// Corporate personal/shared mailboxes, Resend transport, Support shared inbox
// and Marketing Email Studio. Admin-database owned; never stored in product DBs.
// Admin user references that must survive offboarding use onDelete: Restrict.
// -----------------------------------------------------------------------------

enum MailOrganizationKind {
  COMPANY
  BRAND
}

enum MailRecordStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MailDomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  SUSPENDED
}

enum MailCapabilityStatus {
  NOT_CONFIGURED
  PENDING
  VERIFIED
  FAILED
  DISABLED
}

enum MailAddressKind {
  PRIMARY
  ALIAS
  SHARED
  SYSTEM
}

enum MailAddressStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

enum MailMailboxType {
  PERSONAL
  SHARED
}

enum MailMailboxPurpose {
  GENERAL
  SUPPORT
  MARKETING
}

enum MailMembershipRole {
  OWNER
  MANAGER
  MEMBER
  READER
}

enum MailProvisionRequestType {
  PERSONAL_MAILBOX
  SHARED_MAILBOX
  ALIAS
  SENDER_GRANT
}

enum MailProvisionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PROVISIONED
}

enum MailMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MailMessageStatus {
  QUEUED
  PROVIDER_ACCEPTED
  DELIVERED
  DELAYED
  FAILED
  BOUNCED
  COMPLAINED
  RECEIVED
  QUARANTINED
  OUTCOME_UNKNOWN
}

enum MailRecipientType {
  TO
  CC
  BCC
}

enum MailRecipientStatus {
  PENDING
  PROVIDER_ACCEPTED
  DELIVERED
  DELAYED
  FAILED
  BOUNCED
  COMPLAINED
  INTERNAL_DELIVERED
  OUTCOME_UNKNOWN
}

enum MailThreadFolder {
  INBOX
  ARCHIVE
  TRASH
  SPAM
}

enum MailConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MailDraftMode {
  NEW
  REPLY
  REPLY_ALL
  FORWARD
}

enum MailDraftStatus {
  ACTIVE
  SENDING
  SENT
  DISCARDED
}

enum MailAttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  SCAN_FAILED
  SCANNER_UNAVAILABLE
}

enum MailJobQueue {
  OUTBOUND
  INBOUND
  EVENTS
  MARKETING
}

enum MailJobStatus {
  PENDING
  LEASED
  RETRY_SCHEDULED
  RECONCILING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum MailWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum MailDeliveryEventType {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  FAILED
  OPENED
  CLICKED
}

enum MailRetentionAction {
  ARCHIVE
  DELETE
}

enum MailBreakGlassStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum MarketingContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  SUPPRESSED
}

enum MarketingConsentStatus {
  PENDING_CONFIRMATION
  GRANTED
  WITHDRAWN
}

enum MarketingConsentSource {
  WEB_FORM
  IMPORT
  MANUAL
  API
  EVENT
}

enum MarketingSuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
  LEGAL
}

enum MarketingEmailCampaignStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  QUEUED
  SENDING
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
  OUTCOME_UNKNOWN
}

enum MarketingCampaignApprovalDecision {
  APPROVED
  REJECTED
  INVALIDATED
}

enum MarketingCampaignSnapshotKind {
  SUBMISSION
  APPROVAL
}

model MailOrganization {
  id        String               @id @default(uuid()) @db.Uuid
  slug      String               @unique(map: "UQ_mail_organizations_slug") @db.VarChar(64)
  name      String               @db.VarChar(160)
  kind      MailOrganizationKind @default(BRAND)
  status    MailRecordStatus     @default(ACTIVE)
  createdBy String?              @map("created_by")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains                MailDomain[]
  addresses              MailAddress[]
  mailboxes              MailMailbox[]
  provisionRequests      MailProvisionRequest[]
  retentionPolicies      MailRetentionPolicy[]
  legalHolds             MailLegalHold[]
  marketingContacts      MarketingContact[]
  marketingAudiences     MarketingAudience[]
  marketingTemplates     MarketingEmailTemplate[]
  marketingCampaigns     MarketingEmailCampaign[]
  marketingBrandSettings MarketingBrandSettings?
  marketingAutomations   MarketingAutomation[]

  @@map("mail_organizations")
}

model MailDomain {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  domain           String               @unique(map: "UQ_mail_domains_domain") @db.VarChar(253)
  status           MailDomainStatus     @default(PENDING_VERIFICATION)
  sendingStatus    MailCapabilityStatus @default(NOT_CONFIGURED) @map("sending_status")
  receivingStatus  MailCapabilityStatus @default(NOT_CONFIGURED) @map("receiving_status")
  provider         String               @default("resend") @db.VarChar(32)
  providerDomainId String?              @map("provider_domain_id") @db.VarChar(128)
  dnsRecords       Json?                @map("dns_records")
  lastCheckedAt    DateTime?            @map("last_checked_at") @db.Timestamptz(6)
  verifiedAt       DateTime?            @map("verified_at") @db.Timestamptz(6)
  createdBy        String?              @map("created_by")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization MailOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_mail_domains_organization")
  addresses    MailAddress[]

  @@index([organizationId, status], map: "IDX_mail_domains_org_status")
  @@map("mail_domains")
}

model MailMailbox {
  id                       String             @id @default(uuid()) @db.Uuid
  organizationId           String             @map("organization_id") @db.Uuid
  type                     MailMailboxType
  purpose                  MailMailboxPurpose @default(GENERAL)
  name                     String             @db.VarChar(160)
  ownerAdminUserId         String?            @map("owner_admin_user_id")
  status                   MailRecordStatus   @default(ACTIVE)
  signatureHtml            String?            @map("signature_html")
  dailySendQuota           Int                @default(500) @map("daily_send_quota")
  slaFirstResponseMinutes  Int?               @map("sla_first_response_minutes")
  supportTicketLinkEnabled Boolean            @default(false) @map("support_ticket_link_enabled")
  suspendedAt              DateTime?          @map("suspended_at") @db.Timestamptz(6)
  offboardedAt             DateTime?          @map("offboarded_at") @db.Timestamptz(6)
  createdBy                String?            @map("created_by")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization MailOrganization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_mail_mailboxes_organization")
  owner        AdminUser?              @relation("MailMailboxOwner", fields: [ownerAdminUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_mail_mailboxes_owner")
  addresses    MailAddress[]
  memberships  MailMembership[]
  senderGrants MailSenderGrant[]
  threads      MailThread[]
  messages     MailMessage[]
  drafts       MailDraft[]
  labels       MailLabel[]
  rules        MailRule[]
  attachments  MailAttachment[]
  legalHolds   MailLegalHold[]
  breakGlass   MailBreakGlassRequest[]
  retention    MailRetentionPolicy[]

  @@unique([organizationId, ownerAdminUserId], map: "UQ_mail_mailboxes_personal_owner")
  @@index([organizationId, type, status], map: "IDX_mail_mailboxes_org_type_status")
  @@map("mail_mailboxes")
}

model MailAddress {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  domainId         String            @map("domain_id") @db.Uuid
  mailboxId        String?           @map("mailbox_id") @db.Uuid
  localPart        String            @map("local_part") @db.VarChar(64)
