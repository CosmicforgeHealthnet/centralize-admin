model SocialAccountConnection {
  id                      String                 @id @default(uuid()) @db.Uuid
  provider                SocialProvider
  providerConnectionId    String                 @map("provider_connection_id")
  encryptedCredentials    Bytes                  @map("encrypted_credentials")
  credentialVersion       Int                    @default(1) @map("credential_version")
  scopes                  String[]
  status                  SocialConnectionStatus @default(PENDING_AUTHORIZATION)
  accessTokenExpiresAt    DateTime?              @map("access_token_expires_at")
  refreshTokenExpiresAt   DateTime?              @map("refresh_token_expires_at")
  requiresReauthorization Boolean                @default(false) @map("requires_reauthorization")
  lastTestedAt            DateTime?              @map("last_tested_at")
  createdById             String                 @map("created_by_id")
  createdBy               AdminUser              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  identities           SocialPublishingIdentity[]
  webhookSubscriptions SocialWebhookSubscription[]

  @@unique([provider, providerConnectionId])
  @@index([status])
  @@map("social_account_connections")
}

model SocialPublishingIdentity {
  id                 String                  @id @default(uuid()) @db.Uuid
  connectionId       String                  @map("connection_id") @db.Uuid
  connection         SocialAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  providerIdentityId String                  @map("provider_identity_id")
  type               SocialIdentityType
  name               String
  username           String?
  avatarUrl          String?                 @map("avatar_url")
  capabilitiesJson   Json                    @map("capabilities_json")
  role               String?
  disabledAt         DateTime?               @map("disabled_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  targets                 SocialPostTarget[]
  conversations           SocialConversation[]
  comments                SocialComment[]
  engagementEvents        SocialEngagementEvent[]
  webhookSubscriptions    SocialWebhookSubscription[]
  contacts                SocialContact[]
  providerContent         SocialProviderContent[]
  identityMetricSnapshots SocialIdentityMetricSnapshot[]
  syncState               SocialIdentitySyncState?
  actionJobs              SocialActionJob[]

  @@unique([connectionId, providerIdentityId])
  @@map("social_publishing_identities")
}

model SocialOAuthState {
  id                    String         @id @default(uuid()) @db.Uuid
  stateHash             String         @unique @map("state_hash")
  provider              SocialProvider
  adminUserId           String         @map("admin_user_id")
  adminUser             AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  connectionContextJson Json?          @map("connection_context_json")
  encryptedVerifier     Bytes?         @map("encrypted_verifier")
  expiresAt             DateTime       @map("expires_at")
  usedAt                DateTime?      @map("used_at")
  createdAt             DateTime       @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("social_oauth_states")
}

model SocialPost {
  id             String               @id @default(uuid()) @db.Uuid
  title          String?
  status         SocialPostStatus     @default(DRAFT)
  campaignId     String?              @map("campaign_id")
  campaign       marketing_campaigns? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById    String               @map("created_by_id")
  createdBy      AdminUser            @relation("SocialPostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion Int                  @default(1) @map("current_version")
  legacySourceId String?              @map("legacy_source_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  revisions SocialPostRevision[]
  targets   SocialPostTarget[]
  approvals SocialPostApproval[]

  @@index([status])
  @@index([campaignId])
  @@map("social_posts")
}

model SocialPostRevision {
  id            String     @id @default(uuid()) @db.Uuid
  postId        String     @map("post_id") @db.Uuid
  post          SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
