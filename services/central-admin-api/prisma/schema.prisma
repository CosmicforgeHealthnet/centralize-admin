  decision      SocialApprovalDecision @default(PENDING)
  reason        String?
  createdAt     DateTime               @default(now()) @map("created_at")
  decidedAt     DateTime?              @map("decided_at")

  @@index([postId])
  @@map("social_post_approvals")
}

model SocialPublication {
  id                String                  @id @default(uuid()) @db.Uuid
  targetId          String                  @map("target_id") @db.Uuid
  target            SocialPostTarget        @relation(fields: [targetId], references: [id], onDelete: Restrict)
  postVersion       Int                     @map("post_version")
  requestedById     String                  @map("requested_by_id")
  requestedBy       AdminUser               @relation("SocialPublicationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById      String?                 @map("approved_by_id")
  approvedBy        AdminUser?              @relation("SocialPublicationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  providerPostId    String?                 @map("provider_post_id")
  url               String?
  status            SocialPublicationStatus @default(PENDING)
