model MailMessage {
  id                 String               @id @default(uuid()) @db.Uuid
  mailboxId          String               @map("mailbox_id") @db.Uuid
  threadId           String               @map("thread_id") @db.Uuid
  direction          MailMessageDirection
  status             MailMessageStatus
  rfcMessageId       String               @map("rfc_message_id") @db.VarChar(998)
  inReplyTo          String?              @map("in_reply_to") @db.VarChar(998)
  references         String[]             @default([])
  subject            String               @default("") @db.VarChar(998)
  // Encrypted preview (AES-256-GCM, purpose mail-snippet); never plaintext body.
  encryptedSnippet   Bytes?               @map("encrypted_snippet")
  fromAddress        String               @map("from_address") @db.VarChar(320)
  fromName           String?              @map("from_name") @db.VarChar(320)
