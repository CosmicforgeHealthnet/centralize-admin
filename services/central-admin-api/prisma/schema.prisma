// -----------------------------------------------------------------------------
// AUTH

// -----------------------------------------------------------------------------

// ── HQ secure sessions + MFA (20261025_add_admin_sessions_mfa.sql) ─────────
// New tables only. Code must check schema readiness before touching them
// (src/shared/auth/schema-readiness.js); until then login behaves exactly as
// before (admin_refresh_tokens only).

// Server-side login session. Access JWTs carry `sid`; every authenticated
// request checks the session is live. Never created from client input.
model AdminSession {
  id                String                     @id @default(uuid()) @db.Uuid
  adminUserId       String                     @map("admin_user_id")
  adminUser         AdminUser                  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  mode              String                     @db.VarChar(16)
  authMethod        String                     @map("auth_method") @db.VarChar(32)
  csrfNonce         String                     @map("csrf_nonce") @db.VarChar(64)
  createdAt         DateTime                   @default(now()) @map("created_at")
  lastSeenAt        DateTime                   @default(now()) @map("last_seen_at")
  idleExpiresAt     DateTime                   @map("idle_expires_at")
  absoluteExpiresAt DateTime                   @map("absolute_expires_at")
  mfaVerifiedAt     DateTime?                  @map("mfa_verified_at")
  revokedAt         DateTime?                  @map("revoked_at")
  revokeReason      String?                    @map("revoke_reason") @db.VarChar(64)
  ipAddress         String?                    @map("ip_address") @db.VarChar(64)
  userAgent         String?                    @map("user_agent") @db.VarChar(512)
  refreshTokens     AdminSessionRefreshToken[]

  @@index([adminUserId, revokedAt], map: "IDX_admin_sessions_user_active")
  @@map("admin_sessions")
}

// Refresh tokens of a session family (opaque, SHA-256 stored, rotated per use).
// Pre-session refresh tokens stay in admin_refresh_tokens and are upgraded on
// their first refresh after activation.
model AdminSessionRefreshToken {
  id          String       @id @default(uuid()) @db.Uuid
  sessionId   String       @map("session_id") @db.Uuid
  session     AdminSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  adminUserId String       @map("admin_user_id")
  tokenHash   String       @unique(map: "UQ_admin_session_refresh_tokens_hash") @map("token_hash") @db.Char(64)
  createdAt   DateTime     @default(now()) @map("created_at")
  expiresAt   DateTime     @map("expires_at")
  rotatedAt   DateTime?    @map("rotated_at")
  revokedAt   DateTime?    @map("revoked_at")
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  userAgent   String?      @map("user_agent") @db.VarChar(512)

  @@index([sessionId], map: "IDX_admin_session_refresh_tokens_session")
  @@index([adminUserId], map: "IDX_admin_session_refresh_tokens_user")
  @@map("admin_session_refresh_tokens")
}

// Per-user MFA state (1:1). Verified MFA = enrolledAt + secretEncrypted.
model AdminMfaEnrollment {
  adminUserId            String    @id @map("admin_user_id")
  adminUser              AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  enrolledAt             DateTime? @map("enrolled_at")
  secretEncrypted        String?   @map("secret_encrypted")
  pendingSecretEncrypted String?   @map("pending_secret_encrypted")
  pendingExpiresAt       DateTime? @map("pending_expires_at")
  lastUsedStep           Int?      @map("last_used_step")
  failedAttempts         Int       @default(0) @map("failed_attempts")
  lockedUntil            DateTime? @map("locked_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("admin_mfa_enrollments")
}

model AdminMfaRecoveryCode {
