model SocialPublishingJob {
  id                String            @id @default(uuid()) @db.Uuid
  publicationId     String            @unique @map("publication_id") @db.Uuid
  publication       SocialPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  status            SocialJobStatus   @default(PENDING)
  priority          Int               @default(0)
  scheduledForUtc   DateTime          @map("scheduled_for_utc")
  nextAttemptAt     DateTime?         @map("next_attempt_at")
  attemptCount      Int               @default(0) @map("attempt_count")
