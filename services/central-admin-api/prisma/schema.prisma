  title         String?
  baseText      String     @map("base_text")
  snapshotJson  Json       @map("snapshot_json")
  changeSummary String?    @map("change_summary")
  createdById   String     @map("created_by_id")
  createdBy     AdminUser  @relation("SocialPostRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now()) @map("created_at")

  approvals SocialPostApproval[]

  @@unique([postId, version])
  @@map("social_post_revisions")
}

model SocialPostTarget {
  id                     String                   @id @default(uuid()) @db.Uuid
  postId                 String                   @map("post_id") @db.Uuid
  post                   SocialPost               @relation(fields: [postId], references: [id], onDelete: Cascade)
  identityId             String                   @map("identity_id") @db.Uuid
  identity               SocialPublishingIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  status                 SocialTargetStatus       @default(DRAFT)
  text                   String
  optionsJson            Json?                    @map("options_json")
  contentVersion         Int                      @default(1) @map("content_version")
  capabilitySnapshotJson Json?                    @map("capability_snapshot_json")
  validationStatus       String?                  @map("validation_status")
  validationErrorsJson   Json?                    @map("validation_errors_json")
  lastValidatedAt        DateTime?                @map("last_validated_at")
  scheduledForUtc        DateTime?                @map("scheduled_for_utc")
  timezone               String?
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  media        SocialPostMedia[]
  publications SocialPublication[]
  approvals    SocialPostApproval[]

  @@index([scheduledForUtc])
  @@index([status])
  @@map("social_post_targets")
}

model SocialPostApproval {
  id            String                 @id @default(uuid()) @db.Uuid
  postId        String                 @map("post_id") @db.Uuid
  post          SocialPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  revisionId    String                 @map("revision_id") @db.Uuid
  revision      SocialPostRevision     @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  targetId      String?                @map("target_id") @db.Uuid
  target        SocialPostTarget?      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  submittedById String                 @map("submitted_by_id")
