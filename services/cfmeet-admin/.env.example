# CF Meet Admin — example configuration. DISABLED by default.
# Never commit real values. Every secret is read from an operator-mounted
# file referenced by an absolute path; nothing secret is placed in env vars.

CFMEET_ADMIN_ENABLED=false

# Private-only listener. Default: host-private Unix socket (mode 0660).
#   unix:/run/cosmicforge/cfmeet-admin.sock
#   tcp:<loopback-or-private-ip>:<port>   (non-loopback requires mTLS below)
CFMEET_ADMIN_LISTEN=unix:/run/cosmicforge/cfmeet-admin.sock

# Required when enabled.
CFMEET_ADMIN_ENVIRONMENT=
CFMEET_ADMIN_SERVICE_INSTANCE_ID=
# Must match the identity independently approved in the HQ registry.
CFMEET_ADMIN_WORKLOAD_IDENTITY=
CFMEET_ADMIN_BUILD_SHA=
# Dedicated CF Meet Admin database, RUNTIME role (INSERT/SELECT only on audit).
CFMEET_ADMIN_DATABASE_URL=
# HQ Product Integration Core service keys: JSON {"<keyId>":{"service_id":"hq-product-integration-core","key_b64url":"...","not_after":"<ISO>"}}
CFMEET_ADMIN_HQ_SERVICE_KEYS_FILE=
# Delegated staff context keys: JSON {"<kid>":{"key_b64url":"...","not_after":"<ISO>"}}
CFMEET_ADMIN_DELEGATION_KEYS_FILE=

# Manifest signer (optional). Without it GET /manifest answers
# UNAVAILABLE MANIFEST_SIGNER_NOT_PROVISIONED. Ed25519 PKCS#8 PEM.
CFMEET_ADMIN_MANIFEST_SIGNING_KEY_FILE=
CFMEET_ADMIN_MANIFEST_SIGNING_KID=
CFMEET_ADMIN_MANIFEST_REVISION=1
CFMEET_ADMIN_MANIFEST_TTL_SECONDS=3600

# Mutual TLS — required for a non-loopback tcp: listener.
CFMEET_ADMIN_TLS_CERT_FILE=
CFMEET_ADMIN_TLS_KEY_FILE=
CFMEET_ADMIN_TLS_CLIENT_CA_FILE=
# Comma-separated SHA-256 fingerprints of approved HQ client certificates.
CFMEET_ADMIN_ALLOWED_CLIENT_FINGERPRINTS=

# Migration credential — used ONLY by `npm run migrate`, never by the server.
CFMEET_ADMIN_MIGRATION_DATABASE_URL=
CFMEET_ADMIN_RUNTIME_ROLE=

# CF Meet Admin Bridge (read-only capability discovery). Disabled until
# CF Meet enrolls the HQ client certificate, HMAC key and staff signing key.
CFMEET_BRIDGE_ENABLED=false
# https://<bridge-hostname>:<port> — used for TLS server name only.
CFMEET_BRIDGE_ORIGIN=
# Pinned private IP of the bridge (DNS is never consulted).
CFMEET_BRIDGE_ADDRESS=
CFMEET_BRIDGE_CA_FILE=
CFMEET_BRIDGE_CLIENT_CERT_FILE=
CFMEET_BRIDGE_CLIENT_KEY_FILE=
CFMEET_BRIDGE_HMAC_KEY_FILE=
CFMEET_BRIDGE_SERVICE_KID=
CFMEET_BRIDGE_STAFF_PRIVATE_KEY_FILE=
CFMEET_BRIDGE_STAFF_KID=
CFMEET_BRIDGE_ISSUER=
CFMEET_BRIDGE_AUDIENCE=
# Must match CF Meet's approved trust policy.
CFMEET_ADMIN_MARKET=
CFMEET_ADMIN_ORGANIZATION=
CFMEET_ADMIN_ACR=
# Agreed defaults: issuer cosmicforge-hq, audience cfmeet-admin-bridge, staff acr
# urn:cosmicforge:acr:mfa (sent only within 300 s of MFA). Market GLOBAL,
# organization cfmeet, zones production,sandbox.
# HQ product grant role -> approved bridge role. Staff tiers are rejected.
# Example shape: {"cfmeet.capabilities.viewer":"<approved-bridge-read-role>"}
CFMEET_ADMIN_ROLE_MAP={}
# HQ product-grant roles map 1:1 to Bridge roles, e.g.
# {"cfmeet.viewer":"cfmeet.viewer","cfmeet.support":"cfmeet.support","cfmeet.trust_safety":"cfmeet.trust_safety",
#  "cfmeet.verification.reviewer":"cfmeet.verification.reviewer","cfmeet.partner_ops":"cfmeet.partner_ops",
#  "cfmeet.finance":"cfmeet.finance","cfmeet.pricing.editor":"cfmeet.pricing.editor","cfmeet.pricing.approver":"cfmeet.pricing.approver",
#  "cfmeet.platform_ops":"cfmeet.platform_ops","cfmeet.security_admin":"cfmeet.security_admin","cfmeet.release_manager":"cfmeet.release_manager"}

# --- Sections 6-8 ----------------------------------------------------------
# Exact client certificate URI SAN approved by the Bridge enrollment (the
# client certificate must carry exactly this one URI and be currently valid).
CFMEET_BRIDGE_CLIENT_URI=
# Optional: pin the Bridge server certificate (comma-separated SHA-256
# fingerprints) and refuse revoked fingerprints (server or our own client cert).
CFMEET_BRIDGE_SERVER_FINGERPRINTS=
CFMEET_BRIDGE_REVOKED_FINGERPRINTS=
# Zones and tenants enrolled for this Bridge (zone/tenant-scoped routes are
# blocked without them; a staff delegation must still name each explicitly).
CFMEET_ADMIN_ZONES=
CFMEET_ADMIN_TENANTS=
# Seconds since staff MFA accepted for Bridge assertions (30-300, default 300).
CFMEET_ADMIN_BRIDGE_MFA_MAX_AGE_SECONDS=300
# Continuation-token sealing key (own trust boundary; required with the Bridge).
CFMEET_ADMIN_CURSOR_KEY_FILE=
# Explicitly enabled source commands (exact cfmeet.<bridge capability> IDs).
# Empty by default. R3/R4 commands are refused until separately certified.
CFMEET_ADMIN_ENABLED_COMMANDS=
# Datasets this Product Admin certifies for HQ (only after staging evidence):
# cfmeet.engagement_daily,cfmeet.meetings_daily,cfmeet.messaging_daily,cfmeet.partners_daily,cfmeet.apps_daily,cfmeet.verification_queue,cfmeet.trust_safety_queue,cfmeet.operations_health,cfmeet.sync_health
CFMEET_ADMIN_CERTIFIED_DATASETS=

# Stage A worker (node src/worker/index.js, same image). Disabled by default.
CFMEET_BRIDGE_FEED_ENABLED=false
# JSON list of enrolled feed scopes, e.g. [{"market":"..","organization":"..","zone":"..","tenant":".."}]
CFMEET_BRIDGE_FEED_SCOPES=
# Operator-approved Bridge consumer principal (never a human staff identity).
CFMEET_BRIDGE_FEED_CONSUMER=
CFMEET_BRIDGE_FEED_SUBJECT=
CFMEET_BRIDGE_FEED_ROLE=
CFMEET_BRIDGE_FEED_ACR=
# Agreed with the CF Meet Bridge (interface v1): feed role cfmeet.source_sync,
# feed acr urn:cosmicforge:acr:workload (never accepted as a staff acr).
CFMEET_BRIDGE_FEED_PAGE_SIZE=50
CFMEET_BRIDGE_FEED_POLL_SECONDS=15
CFMEET_BRIDGE_FEED_REWIND_EVENTS=200
CFMEET_BRIDGE_FEED_LEASE_SECONDS=60
# Certified Bridge datasets (bridge.datasets.read) are pulled as daily series:
# every N seconds (300-86400), reading the last D UTC days (1-31).
CFMEET_BRIDGE_DATASET_PULL_SECONDS=900
CFMEET_BRIDGE_DATASET_DAYS=3
CFMEET_BRIDGE_RECONCILE_INTERVAL_SECONDS=86400
CFMEET_ADMIN_INBOX_RETENTION_DAYS=90
