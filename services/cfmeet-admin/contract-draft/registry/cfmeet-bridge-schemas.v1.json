{
 "components": {
  "schemas": {
   "Scope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "product",
     "market",
     "organization",
     "zone",
     "tenant"
    ],
    "properties": {
     "product": {
      "const": "cfmeet"
     },
     "market": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "organization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "zone": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     }
    }
   },
   "ResourceItem": {
    "type": "object",
    "required": [
     "id",
     "kind"
    ],
    "maxProperties": 48,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "status": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "version": {
      "type": "integer",
      "minimum": 0
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     }
    },
    "additionalProperties": {
     "type": [
      "string",
      "integer",
      "number",
      "boolean",
      "null"
     ]
    }
   },
   "HistoryEntry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "at",
     "action",
     "actor_ref"
    ],
    "properties": {
     "at": {
      "type": "string",
      "format": "date-time"
     },
     "action": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "actor_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "from_status": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 128
     },
     "to_status": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 128
     },
     "reason_code": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 64
     }
    }
   },
   "ResourcePage": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "scope",
     "as_of",
     "coverage",
     "items",
     "next_cursor"
    ],
    "properties": {
     "contract_version": {
      "const": "cfmeet.admin-resources.v1"
     },
     "scope": {
      "$ref": "#/components/schemas/Scope"
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL",
       "CONTEXT_SCOPED_PARTIAL"
      ]
     },
     "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/ResourceItem"
      }
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 4096
     }
    }
   },
   "ResourceDetail": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "scope",
     "as_of",
     "coverage",
     "item",
     "history"
    ],
    "properties": {
     "contract_version": {
      "const": "cfmeet.admin-resources.v1"
     },
     "scope": {
      "$ref": "#/components/schemas/Scope"
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL",
       "CONTEXT_SCOPED_PARTIAL"
      ]
     },
     "item": {
      "$ref": "#/components/schemas/ResourceItem"
     },
     "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/HistoryEntry"
      }
     }
    }
   },
   "VerificationCase": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "case_id",
     "product",
     "kind",
     "subject_ref",
     "state",
     "version",
     "assignee_ref",
     "submitted_at",
     "updated_at",
     "evidence"
    ],
    "properties": {
     "case_id": {
      "type": "string",
      "format": "uuid"
     },
     "product": {
      "const": "cfmeet"
     },
     "kind": {
      "enum": [
       "PARTNER_GO_LIVE",
       "APP_REVIEW",
       "APP_PUBLISH"
      ]
     },
     "subject_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "state": {
      "enum": [
       "OPEN",
       "CLAIMED",
       "APPROVED",
       "REJECTED",
       "SUSPENDED",
       "PUBLISHED"
      ]
     },
     "version": {
      "type": "integer",
      "minimum": 1
     },
     "assignee_ref": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 128
     },
     "submitted_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "kind",
        "ref",
        "sha256"
       ],
       "properties": {
        "kind": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "ref": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      }
     }
    }
   },
   "VerificationCasePage": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "scope",
     "as_of",
     "coverage",
     "items",
     "next_cursor"
    ],
    "properties": {
     "contract_version": {
      "const": "cfmeet.admin-resources.v1"
     },
     "scope": {
      "$ref": "#/components/schemas/Scope"
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL"
      ]
     },
     "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/VerificationCase"
      }
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 4096
     }
    }
   },
   "VerificationCaseDetail": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "scope",
     "as_of",
     "coverage",
     "item",
     "history"
    ],
    "properties": {
     "contract_version": {
      "const": "cfmeet.admin-resources.v1"
     },
     "scope": {
      "$ref": "#/components/schemas/Scope"
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL"
      ]
     },
     "item": {
      "$ref": "#/components/schemas/VerificationCase"
     },
     "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "$ref": "#/components/schemas/HistoryEntry"
      }
     }
    }
   },
   "Summary": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "scope",
     "as_of",
     "coverage",
     "window",
     "cells"
    ],
    "properties": {
     "contract_version": {
      "const": "cfmeet.admin-summary.v1"
     },
     "scope": {
      "$ref": "#/components/schemas/Scope"
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL"
      ]
     },
     "window": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "start",
         "end"
        ],
        "properties": {
         "start": {
          "type": "string",
          "format": "date-time"
         },
         "end": {
          "type": "string",
          "format": "date-time"
         }
        }
       }
      ]
     },
     "cells": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "key",
        "value",
        "unit",
        "currency",
        "suppression"
       ],
       "properties": {
        "key": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "value": {
         "type": [
          "integer",
          "null"
         ]
        },
        "unit": {
         "enum": [
          "count",
          "minor_currency",
          "seconds"
         ]
        },
        "currency": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[A-Z]{3}$"
        },
        "suppression": {
         "enum": [
          "NONE",
          "SMALL_CELL",
          "PARTIAL_COVERAGE"
         ]
        }
       }
      }
     }
    }
   },
   "Health": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "status",
     "services"
    ],
    "properties": {
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "status": {
      "enum": [
       "OK",
       "DEGRADED",
       "DOWN",
       "UNKNOWN"
      ]
     },
     "services": {
      "type": "array",
      "maxItems": 64,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "service",
        "status",
        "checked_at"
       ],
       "properties": {
        "service": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "status": {
         "enum": [
          "OK",
          "DEGRADED",
          "DOWN",
          "UNKNOWN"
         ]
        },
        "checked_at": {
         "type": "string",
         "format": "date-time"
        }
       }
      }
     }
    }
   },
   "CapabilityStates": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "contract_version",
     "openapi_sha256",
     "policy_revision",
     "capabilities"
    ],
    "properties": {
     "contract_version": {
      "type": "string",
      "maxLength": 32
     },
     "openapi_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "policy_revision": {
      "type": "integer",
      "minimum": 1
     },
     "capabilities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "state"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "state": {
         "enum": [
          "AVAILABLE",
          "READ_ONLY",
          "DISABLED",
          "BLOCKED_DEPENDENCY"
         ]
        },
        "blocker": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 256
        }
       }
      }
     }
    }
   },
   "DatasetSeries": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "dataset_id",
     "coverage",
     "window",
     "series",
     "next_cursor"
    ],
    "properties": {
     "dataset_id": {
      "type": "string",
      "pattern": "^cfmeet\\.[a-z_]{1,48}$"
     },
     "coverage": {
      "enum": [
       "COMPLETE",
       "PARTIAL",
       "NONE"
      ]
     },
     "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "start",
       "end"
      ],
      "properties": {
       "start": {
        "type": "string",
        "format": "date-time"
       },
       "end": {
        "type": "string",
        "format": "date-time"
       }
      }
     },
     "series": {
      "type": "array",
      "maxItems": 31,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "date",
        "metrics"
       ],
       "properties": {
        "date": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "metrics": {
         "type": "object",
         "maxProperties": 16,
         "propertyNames": {
          "pattern": "^[a-z][a-z_]{0,47}$"
         },
         "additionalProperties": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         }
        }
       }
      }
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 4096
     }
    }
   },
   "CommandRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "operation_id",
     "idempotency_key",
     "reason_code",
     "expected_version",
     "requested_at",
     "params"
    ],
    "properties": {
     "operation_id": {
      "type": "string",
      "format": "uuid"
     },
     "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{16,128}$"
     },
     "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
     },
     "case_ref": {
      "type": "string",
      "maxLength": 128
     },
     "expected_version": {
      "type": "integer",
      "minimum": 0
     },
     "requested_at": {
      "type": "string",
      "format": "date-time"
     },
     "params": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
       "type": [
        "string",
        "integer",
        "number",
        "boolean",
        "null"
       ]
      }
     }
    }
   },
   "CommandResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "operation_id",
     "status",
     "source_version"
    ],
    "properties": {
     "operation_id": {
      "type": "string",
      "format": "uuid"
     },
     "status": {
      "enum": [
       "ACCEPTED",
       "PENDING",
       "CONFIRMED",
       "COMPLETED",
       "REJECTED",
       "FAILED_TERMINAL"
      ]
     },
     "source_version": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0
     },
     "reason_code": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 64
     },
     "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "recorded_version",
       "recorded_at"
      ],
      "properties": {
       "recorded_version": {
        "type": "integer",
        "minimum": 0
       },
       "recorded_at": {
        "type": "string",
        "format": "date-time"
       }
      }
     }
    }
   },
   "OperationRecord": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "operation_id",
     "status",
     "source_version",
     "updated_at"
    ],
    "properties": {
     "operation_id": {
      "type": "string",
      "format": "uuid"
     },
     "status": {
      "enum": [
       "ACCEPTED",
       "PENDING",
       "CONFIRMED",
       "COMPLETED",
       "REJECTED",
       "FAILED_TERMINAL"
      ]
     },
     "source_version": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0
     },
     "reason_code": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 64
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "ExportDownloadRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "grant_id"
    ],
    "properties": {
     "grant_id": {
      "type": "string",
      "format": "uuid"
     }
    }
   },
   "HQEventAck": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "consumer",
     "sequence"
    ],
    "properties": {
     "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "sequence": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "HQEventAckResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "consumer",
     "acknowledged_sequence"
    ],
    "properties": {
     "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
     },
     "acknowledged_sequence": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "HQEventFeed": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "events",
     "next_sequence",
     "head_sequence",
     "as_of"
    ],
    "properties": {
     "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "schema",
        "event_id",
        "sequence",
        "event_type",
        "source_service",
        "product",
        "entity_type",
        "entity_ref",
        "entity_version",
        "tombstone",
        "occurred_at",
        "emitted_at",
        "market",
        "scope",
        "classification",
        "correlation_id",
        "payload"
       ],
       "properties": {
        "schema": {
         "const": "cosmicforge.product-admin-event.v1"
        },
        "event_id": {
         "type": "string",
         "format": "uuid"
        },
        "sequence": {
         "type": "integer",
         "minimum": 1
        },
        "event_type": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "source_service": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "product": {
         "const": "cfmeet"
        },
        "entity_type": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "entity_ref": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
         "maxLength": 128
        },
        "entity_version": {
         "type": "integer",
         "minimum": 1
        },
        "tombstone": {
         "type": "boolean"
        },
        "occurred_at": {
         "type": "string",
         "format": "date-time"
        },
        "emitted_at": {
         "type": "string",
         "format": "date-time"
        },
        "market": {
         "type": "string",
         "maxLength": 128
        },
        "scope": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "zone",
          "organization",
          "tenant"
         ],
         "properties": {
          "zone": {
           "type": "string",
           "maxLength": 128
          },
          "organization": {
           "type": "string",
           "maxLength": 128
          },
          "tenant": {
           "type": "string",
           "maxLength": 128
          }
         }
        },
        "classification": {
         "enum": [
          "PUBLIC",
          "INTERNAL",
          "OPERATIONS_MINIMIZED",
          "FINANCIAL_SENSITIVE",
          "SAFETY_EVIDENCE"
         ]
        },
        "correlation_id": {
         "type": "string",
         "maxLength": 128
        },
        "payload": {
         "type": "object",
         "maxProperties": 32
        }
       }
      }
     },
     "next_sequence": {
      "type": "integer",
      "minimum": 0
     },
     "head_sequence": {
      "type": "integer",
      "minimum": 0
     },
     "as_of": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "HQProjectionStatus": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "as_of",
     "freshness_threshold_seconds",
     "sources",
     "quarantined",
     "head_sequence",
     "consumer_lag"
    ],
    "properties": {
     "as_of": {
      "type": "string",
      "format": "date-time"
     },
     "freshness_threshold_seconds": {
