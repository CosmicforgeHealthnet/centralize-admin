{
  "name": "cosmicforge-centralize-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized admin multi-service repository (independently deployed applications)",
  "scripts": {
    "layout:check": "node infrastructure/scripts/check-layout.mjs",
    "api:dev": "npm --prefix services/central-admin-api run dev",
    "api:start": "npm --prefix services/central-admin-api run start",
    "api:test": "npm --prefix services/central-admin-api test",
    "api:config:validate": "npm --prefix services/central-admin-api run config:validate",
    "web:dev": "npm --prefix apps/central-admin-web run dev",
    "web:lint": "npm --prefix apps/central-admin-web run lint",
    "web:build": "npm --prefix apps/central-admin-web run build"
  }
}
