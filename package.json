{
  "name": "admin-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --require ./tests/helpers/network-guard.js --test",
    "test:network-guard": "node --require ./tests/helpers/network-guard.js --test tests/network-guard.test.js",
    "test:social-operations": "node scripts/social-operations/run-focused-tests.js",
    "social:test:focused": "node scripts/social-operations/run-focused-tests.js",
    "config:validate": "node scripts/social-operations/validate-config.js",
    "config:validate:staging": "node scripts/social-operations/validate-config.js --mode=staging --synthetic",
    "config:validate:production": "node scripts/social-operations/validate-config.js --mode=production --synthetic",
    "db:manifest:verify": "node scripts/social-operations/migration-manifest.js",
    "db:replay:verify": "node scripts/social-operations/db-replay-verify.js",
    "db:replay:ci": "node scripts/social-operations/db-replay-verify.js",
    "db:schema:assert": "node scripts/social-operations/schema-assertions.js",
    "security:secret-scan": "node scripts/social-operations/secret-scan.js",
    "security:audit-policy": "node scripts/security/check-npm-audit-policy.js",
    "security:audit-policy:production": "node scripts/security/check-npm-audit-policy.js --omit-dev",
    "security:sbom": "node scripts/security/generate-sbom.js",
    "security:static-social": "node scripts/social-operations/static-code-safety-check.js",
    "security:network-guard-static": "node scripts/security/check-test-network-safety.js",
    "social:ci": "npm run config:validate && npm run db:manifest:verify && npm run migrations:safety && npm run security:secret-scan && npm run security:audit-policy && npm run security:static-social && npm run security:network-guard-static && npm run test:network-guard && npm run test:social-operations && npm test",
    "migrations:safety": "node scripts/social-operations/migration-safety-check.js",
    "db:seed": "node prisma/seeds/admin.seed.js",
    "studio": "prisma studio --config prisma.config.ts",
    "studio:main:dev": "cross-env MAIN_DB_ENV=dev prisma studio --config prisma.main.config.ts",
    "studio:main:prod": "cross-env MAIN_DB_ENV=prod prisma studio --config prisma.main.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "oauth-1.0a": "2.2.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
