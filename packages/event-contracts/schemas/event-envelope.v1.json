{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmicforge.internal/product-admin/event-envelope.v1.json",
  "title": "CosmicForge Product Admin event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "schema_id",
    "schema_version",
    "family",
    "event_id",
    "source_id",
    "product_id",
    "dataset_id",
    "partition_key",
    "sequence",
    "entity",
    "scope",
    "classification",
    "occurred_at",
    "emitted_at",
    "payload",
    "payload_digest"
  ],
  "properties": {
    "envelope": {
      "type": "string",
      "const": "cosmicforge.product-admin.event/v1"
    },
    "schema_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "partition_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED_PII"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
