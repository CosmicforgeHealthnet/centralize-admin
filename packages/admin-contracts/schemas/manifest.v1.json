{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmicforge.internal/product-admin/manifest.v1.json",
  "title": "CosmicForge Product Admin Protocol manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "cosmicforge.product-admin.manifest/v1"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "service_instance_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "test",
        "development",
        "staging",
        "production"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} .&'-]*$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "build_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "workload_identity": {
      "type": "string",
      "pattern": "^(?:spiffe|cf)://[a-z0-9.-]{1,63}(?:/[A-Za-z0-9._-]{1,63}){1,6}$"
    },
    "signing_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "METADATA",
              "READ",
              "COMMAND"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "READ_ONLY",
              "DISABLED",
              "BLOCKED_POLICY",
              "BLOCKED_DEPENDENCY",
              "UNAVAILABLE"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 240
          },
          "datasets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
            },
            "maxItems": 32,
            "uniqueItems": true
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "code",
                "detail"
              ]
            },
            "maxItems": 16,
            "uniqueItems": true
          },
          "requires_recent_mfa": {
            "type": "boolean"
          },
          "requires_independent_approval": {
            "type": "boolean"
          },
          "request_schema": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "state",
          "risk",
          "description",
          "datasets",
          "blockers",
          "requires_recent_mfa",
          "requires_independent_approval",
          "request_schema"
        ]
      },
      "maxItems": 256
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
          },
          "schema_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "schema_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "privacy_class": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED_PII"
            ]
          },
          "scope_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "market",
                "organization",
                "zone",
                "tenant"
              ]
            },
            "maxItems": 4,
            "uniqueItems": true,
            "minItems": 1
          },
          "authorized_departments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,47}$"
            },
            "maxItems": 32,
            "uniqueItems": true,
            "minItems": 1
          },
          "semantic_grain": {
            "type": "string",
            "enum": [
              "EVENT",
              "HOUR",
              "DAY",
              "WEEK",
              "MONTH",
              "SNAPSHOT"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "maxItems": 16,
            "uniqueItems": true
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "freshness_target_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 2678400
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_system": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "source_owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "derivation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "source_system",
              "source_owner",
              "derivation"
            ]
          },
          "allowed_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "date-time"
                  ]
                },
                "classification": {
                  "type": "string",
                  "enum": [
                    "PUBLIC",
                    "INTERNAL",
                    "CONFIDENTIAL",
                    "RESTRICTED_PII"
                  ]
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                }
              },
              "required": [
                "name",
                "type",
                "classification",
                "meaning",
                "unit"
              ]
            },
            "maxItems": 64,
            "uniqueItems": true,
            "minItems": 1
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metric_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
                },
                "definition": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "aggregation": {
                  "type": "string",
                  "enum": [
                    "SUM",
                    "COUNT",
                    "AVG",
                    "RATIO",
                    "MIN",
                    "MAX",
                    "GAUGE"
                  ]
                },
                "grain": {
                  "type": "string",
                  "enum": [
                    "EVENT",
                    "HOUR",
                    "DAY",
                    "WEEK",
                    "MONTH",
                    "SNAPSHOT"
                  ]
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "metric_id",
                "version",
                "definition",
                "aggregation",
                "grain",
                "unit",
                "currency"
              ]
            },
            "maxItems": 64,
            "uniqueItems": true
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "readiness": {
            "type": "string",
            "enum": [
              "CERTIFIED_BY_PRODUCT",
              "PROPOSED",
              "NOT_CERTIFIED",
              "BLOCKED"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "code",
                "detail"
              ]
            },
            "maxItems": 16,
            "uniqueItems": true
          }
        },
        "required": [
          "dataset_id",
          "version",
          "schema_id",
          "schema_digest",
          "title",
          "privacy_class",
          "scope_dimensions",
          "authorized_departments",
          "semantic_grain",
          "units",
          "currency",
          "freshness_target_seconds",
          "lineage",
          "allowed_fields",
          "metrics",
          "retention_days",
          "readiness",
          "blockers"
        ]
      },
      "maxItems": 128
    },
    "event_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "schema_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "schema_version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
          },
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "classification": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED_PII"
            ]
          },
          "projection": {
            "type": "string",
            "enum": [
              "METRIC_OBSERVATION",
              "NONE"
            ]
          },
          "payload_schema": {
            "type": "object"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DEPRECATED",
              "NOT_CERTIFIED"
            ]
          },
          "sunset_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version_policy": {
            "type": "string",
            "const": "MAJOR_FOR_BREAKING"
          }
        },
        "required": [
          "family",
          "schema_id",
          "schema_version",
          "dataset_id",
          "classification",
          "projection",
          "payload_schema",
          "status",
          "sunset_at",
          "version_policy"
        ]
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema",
    "product_id",
    "service_instance_id",
    "environment",
    "display_name",
    "protocol",
    "build_sha",
    "manifest_revision",
    "issued_at",
    "expires_at",
    "workload_identity",
    "signing_key_id",
    "capabilities",
    "datasets",
    "event_families"
  ]
}
