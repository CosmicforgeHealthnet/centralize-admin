{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmicforge.internal/product-admin/metric-observation.v1.json",
  "title": "CosmicForge Product Admin Protocol metric-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metric_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "definition_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "value_state": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "UNAVAILABLE"
      ]
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "metric_id",
    "definition_version",
    "window_start",
    "window_end",
    "value",
    "value_state",
    "unit",
    "currency",
    "coverage",
    "observed_at"
  ]
}
