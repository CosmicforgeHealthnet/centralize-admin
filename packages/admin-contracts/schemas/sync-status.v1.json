{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmicforge.internal/product-admin/sync-status.v1.json",
  "title": "CosmicForge Product Admin Protocol sync-status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_source",
    "partitions",
    "last_source_observation"
  ],
  "properties": {
    "event_source": {
      "type": "string",
      "enum": [
        "CERTIFIED",
        "NOT_CERTIFIED",
        "UNAVAILABLE"
      ]
    },
    "partitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "partition_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "head_sequence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dataset_id",
          "partition_key",
          "head_sequence"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
          },
          "readiness": {
            "type": "string",
            "enum": [
              "CERTIFIED_BY_PRODUCT",
              "PROPOSED",
              "NOT_CERTIFIED",
              "BLOCKED"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "detail": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "code",
                "detail"
              ]
            },
            "maxItems": 16,
            "uniqueItems": true
          }
        },
        "required": [
          "dataset_id",
          "readiness",
          "blockers"
        ]
      }
    },
    "last_source_observation": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
