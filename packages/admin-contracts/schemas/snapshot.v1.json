{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cosmicforge.internal/product-admin/snapshot.v1.json",
  "title": "CosmicForge Product Admin Protocol snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})\\.(?:0|[1-9][0-9]{0,3})$"
    },
    "partitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "partition_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "through_sequence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "partition_key",
          "through_sequence"
        ]
      }
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,95}$"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "version": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "id",
              "version"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "market": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
              },
              "organization": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
              },
              "zone": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
              },
              "tenant": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
              }
            }
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "entity",
          "scope",
          "payload"
        ]
      }
    },
    "complete": {
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_id",
    "dataset_id",
    "dataset_version",
    "partitions",
    "records",
    "complete"
  ]
}
