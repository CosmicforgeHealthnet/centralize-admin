// -----------------------------------------------------------------------------
// ADMIN USER
// -----------------------------------------------------------------------------

model AdminUser {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String
  name                 String
  position             String?
  department           Department?
  tier                 AdminTier   @default(EMPLOYEE)
  status               AdminStatus @default(PENDING)
  isTeamLead           Boolean     @default(false)
  failedLoginAttempts  Int         @default(0)
  googleId             String?     @unique
  mainAppUserId        String?     @unique
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  mustChangePassword   Boolean     @default(true)
  passwordResetToken   String?     @unique
  passwordResetExpires DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?

  //  2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  //  Avatar
  avatarUrl          String?
  avatarCloudinaryId String?

  //  Personal Info (self-editable)
  preferredName String?
  birthday      DateTime?
  nationality   String?
  gender        String?
  maritalStatus String?

  //  Contact Info (self-editable)
  workPhone     String?
  homePhone     String?
  personalPhone String?
  fax           String?
  address       String?
  state         String?
  country       String?

  //  Emergency Contact (self-editable)
  emergencyName     String?
  emergencyPhone    String?
  emergencyEmail    String?
  emergencyRelation String?

  //  Employment Details  set by SUPER/EXECUTIVE
  employmentType     String?
  employmentCategory String?
  location           String?

  //  Sensitive  only SUPER/EXECUTIVE can write these
  salary Decimal? @db.Decimal(15, 2)
  bonus  Decimal? @db.Decimal(15, 2)
  equity Decimal? @db.Decimal(15, 2)

  //  Relations
  refreshTokens                     RefreshToken[]
  auditLogs                         AuditLog[]
  socialLinks                       AdminSocialLink[]
  educations                        AdminEducation[]
  documents                         AdminDocument[]
  performanceNotes                  AdminPerformanceNote[]
  reports                           AdminReport[]
  sectionGrants                     AdminSectionGrant[]
  marketingCampaignTeamMemberships  marketing_campaign_team_members[]        @relation("marketing_campaign_team_members_adminUserIdToAdminUser")
  marketingContentItems             marketing_content_items[]                @relation("marketing_content_items_authorIdToAdminUser")
  socialAccountConnections          SocialAccountConnection[]
  socialOAuthStates                 SocialOAuthState[]
  socialPostsCreated                SocialPost[]                             @relation("SocialPostCreatedBy")
  socialPostRevisionsCreated        SocialPostRevision[]                     @relation("SocialPostRevisionCreatedBy")
  socialApprovalsSubmitted          SocialPostApproval[]                     @relation("SocialApprovalSubmittedBy")
  socialApprovalsDecided            SocialPostApproval[]                     @relation("SocialApprovalDecidedBy")
  socialPublicationsRequested       SocialPublication[]                      @relation("SocialPublicationRequestedBy")
  socialPublicationsApproved        SocialPublication[]                      @relation("SocialPublicationApprovedBy")
  socialMediaAssets                 SocialMediaAsset[]
  socialContactsLinked              SocialContact[]                          @relation("SocialContactLinkedBy")
  socialConversationsAssigned       SocialConversation[]                     @relation("SocialConversationAssignee")
  socialConversationAssignments     SocialConversation[]                     @relation("SocialConversationAssignedBy")
  socialMessagesSent                SocialMessage[]
  socialConversationTagsAdded       SocialConversationTag[]                  @relation("SocialConversationTagTaggedBy")
  socialCommentsAssigned            SocialComment[]                          @relation("SocialCommentAssignee")
  socialCommentsSent                SocialComment[]                          @relation("SocialCommentSentByAdmin")
  socialEscalationsConfirmed        SocialEscalation[]                       @relation("SocialEscalationConfirmedBy")
  socialInternalNotesAuthored       SocialInternalNote[]
  socialSavedRepliesCreated         SocialSavedReply[]
  socialSettingsUpdated             SocialOperationsSetting[]
  marketingRecommendationsAccepted  marketing_recommendations[]              @relation("MarketingRecommendationAcceptedBy")
  marketingRecommendationsDismissed marketing_recommendations[]              @relation("MarketingRecommendationDismissedBy")
  marketingAlertsResolved           marketing_alerts[]                       @relation("MarketingAlertResolvedBy")
  marketingAlertsAcknowledged       marketing_alerts[]                       @relation("MarketingAlertAcknowledgedBy")
  marketingExperimentsCreated       marketing_experiments[]                  @relation("MarketingExperimentCreatedBy")
  marketingEvaluationRunsRequested  marketing_intelligence_evaluation_runs[] @relation("MarketingEvaluationRunRequestedBy")
  marketingSettingsUpdated          marketing_intelligence_settings[]        @relation("MarketingIntelligenceSettingUpdatedBy")

  //  Work Section Relations
  teamMemberships       TeamMember[]
  projectMemberships    ProjectMember[]
  assignedTasks         Task[]          @relation("TaskAssignee")
  createdTasks          Task[]          @relation("TaskAssigner")
  notifications         Notification[]
  attendanceLogs        AttendanceLog[]
  leaveRequests         LeaveRequest[]  @relation("LeaveRequestEmployee")
  reviewedLeaveRequests LeaveRequest[]  @relation("LeaveRequestReviewer")
  leaveBalances         LeaveBalance[]
  payrollRecords        PayrollRecord[]
  payslips              Payslip[]
  deductions            Deduction[]
  receipts              Receipt[]
  invoices              Invoice[]

  @@map("admin_users")
}

// MARKETING

model marketing_campaigns {
  id             String                         @id(map: "PK_marketing_campaigns") @default(uuid())
  title          String                         @db.VarChar(255)
  type           marketing_campaign_type_enum
  status         marketing_campaign_status_enum @default(Drafts)
  description    String?
  budget         Decimal?                       @db.Decimal(12, 2)
  progress       Int                            @default(0)
  launchDate     DateTime?                      @db.Date
  estCompletion  DateTime?                      @db.Date
  targetAudience String?
  duration       String?                        @db.VarChar(100)
  channels       Json?                          @db.Json
  overview       String?
  createdAt      DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                       @updatedAt @db.Timestamp(6)

  performance marketing_campaign_performance?
  timeline    marketing_campaign_timeline[]
  team        marketing_campaign_team_members[]
  socialPosts SocialPost[]

  @@index([status], map: "IDX_marketing_campaigns_status")
  @@index([type], map: "IDX_marketing_campaigns_type")
  @@index([launchDate], map: "IDX_marketing_campaigns_launchDate")
  @@index([createdAt], map: "IDX_marketing_campaigns_createdAt")
}

model marketing_campaign_performance {
  id             String   @id(map: "PK_marketing_campaign_performance") @default(uuid())
  campaignId     String   @unique(map: "UQ_marketing_campaign_performance_campaignId")
  opens          Int      @default(0)
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  totalReach     Int      @default(0)
  engagementRate Decimal  @default(0) @db.Decimal(8, 2)
  conversionRate Decimal  @default(0) @db.Decimal(8, 2)
  costPerClick   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  campaign marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_performance_campaignId")

  @@index([campaignId], map: "IDX_marketing_campaign_performance_campaignId")
}

model marketing_campaign_timeline {
  id         String   @id(map: "PK_marketing_campaign_timeline") @default(uuid())
  campaignId String
  label      String   @db.VarChar(255)
  date       DateTime @db.Date
  done       Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  campaign marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_timeline_campaignId")

  @@index([campaignId], map: "IDX_marketing_campaign_timeline_campaignId")
  @@index([sortOrder, date], map: "IDX_marketing_campaign_timeline_order")
}

model marketing_campaign_team_members {
  id          String   @id(map: "PK_marketing_campaign_team_members") @default(uuid())
  campaignId  String
  adminUserId String?
  role        String   @db.VarChar(150)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  campaign  marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_team_members_campaignId")
  adminUser AdminUser?          @relation("marketing_campaign_team_members_adminUserIdToAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_marketing_campaign_team_members_adminUserId")

  @@index([campaignId], map: "IDX_marketing_campaign_team_members_campaignId")
  @@index([adminUserId], map: "IDX_marketing_campaign_team_members_adminUserId")
}

model marketing_content_items {
  id          String                        @id(map: "PK_marketing_content_items") @default(uuid())
  title       String                        @db.VarChar(255)
  type        String                        @db.VarChar(100)
  authorId    String?
  authorName  String?                       @db.VarChar(255)
  link        String?                       @db.VarChar(1000)
  description String?
  status      marketing_content_status_enum @default(Draft)
  performance Int                           @default(0)
  createdAt   DateTime                      @default(now()) @db.Timestamp(6)
  updatedAt   DateTime                      @updatedAt @db.Timestamp(6)

  adminUser          AdminUser?                              @relation("marketing_content_items_authorIdToAdminUser", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_marketing_content_items_authorId")
  monthlyPerformance marketing_content_monthly_performance[]

  @@index([status], map: "IDX_marketing_content_items_status")
  @@index([authorId], map: "IDX_marketing_content_items_authorId")
  @@index([updatedAt], map: "IDX_marketing_content_items_updatedAt")
}

model marketing_content_monthly_performance {
  id        String   @id(map: "PK_marketing_content_monthly_performance") @default(uuid())
  contentId String
  month     String   @db.VarChar(20)
  value     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  content marketing_content_items @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_content_monthly_performance_contentId")

  @@index([contentId], map: "IDX_marketing_content_monthly_performance_contentId")
  @@index([sortOrder], map: "IDX_marketing_content_monthly_performance_sortOrder")
}

model marketing_notification_events {
  id               String    @id(map: "PK_marketing_notification_events") @default(uuid())
  eventCode        String    @unique(map: "UQ_marketing_notification_events_eventCode") @db.VarChar(20)
  event            String    @db.VarChar(255)
  notifyEnabled    Boolean   @default(true)
  emailEnabled     Boolean   @default(true)
  whatsappEnabled  Boolean   @default(true)
  smsEnabled       Boolean   @default(true)
  recipients       Json?     @db.Json
  validToDate      DateTime? @db.Date
  customerFullName String?   @db.VarChar(255)
  customerEmail    String?   @db.VarChar(255)
  customerPhone    String?   @db.VarChar(50)
  customerCountry  String?   @db.VarChar(100)
  emailContent     Json?     @db.Json
  conditionalBlock Json?     @db.Json
  whatsappContent  Json?     @db.Json
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @db.Timestamp(6)

  templates marketing_email_templates[]

  @@index([event], map: "IDX_marketing_notification_events_event")
  @@index([validToDate], map: "IDX_marketing_notification_events_validToDate")
  @@index([createdAt], map: "IDX_marketing_notification_events_createdAt")
}

model marketing_email_templates {
  id        String   @id(map: "PK_marketing_email_templates") @default(uuid())
  eventId   String
  validFrom DateTime @db.Date
  validTo   DateTime @db.Date
  language  String   @db.VarChar(20)
  status    String   @default("Active") @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  event marketing_notification_events @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_email_templates_eventId")

  @@index([eventId], map: "IDX_marketing_email_templates_eventId")
  @@index([validTo], map: "IDX_marketing_email_templates_validTo")
  @@index([createdAt], map: "IDX_marketing_email_templates_createdAt")
}

model marketing_social_accounts {
  id                String                         @id(map: "PK_marketing_social_accounts") @default(uuid())
  platform          marketing_social_platform_enum
  username          String                         @db.VarChar(255)
  connected         Boolean                        @default(true)
  encryptedPassword String?
  credentialsSaved  Boolean                        @default(false)
  createdAt         DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt         DateTime                       @updatedAt @db.Timestamp(6)

  @@unique([platform, username], map: "UQ_marketing_social_accounts_platform_username")
  @@index([platform], map: "IDX_marketing_social_accounts_platform")
  @@index([connected], map: "IDX_marketing_social_accounts_connected")
}

model marketing_social_posts {
  id             String                            @id(map: "PK_marketing_social_posts") @default(uuid())
  platform       marketing_social_platform_enum
  caption        String
  description    String?
  excerpt        String?
  attachmentUrl  String?                           @db.VarChar(1000)
  attachmentUrls Json?                             @db.Json
  thumbnailUrl   String?                           @db.VarChar(1000)
  imageUrl       String?                           @db.VarChar(1000)
