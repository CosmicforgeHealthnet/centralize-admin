model SocialActionJob {
  id                String                   @id @default(uuid()) @db.Uuid
  jobType           SocialActionJobType      @map("job_type")
  status            SocialActionStatus       @default(PENDING)
  identityId        String                   @map("identity_id") @db.Uuid
  identity          SocialPublishingIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  publicationId     String?                  @map("publication_id") @db.Uuid
  publication       SocialPublication?       @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  providerContentId String?                  @map("provider_content_id") @db.Uuid
  providerContent   SocialProviderContent?   @relation(fields: [providerContentId], references: [id], onDelete: Cascade)
  messageId         String?                  @map("message_id") @db.Uuid
  message           SocialMessage?           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  commentId         String?                  @map("comment_id") @db.Uuid
  comment           SocialComment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  idempotencyKey    String                   @unique @map("idempotency_key")
  payloadJson       Json?                    @map("payload_json")
  priority          Int                      @default(0)
  scheduledForUtc   DateTime                 @default(now()) @map("scheduled_for_utc")
  nextAttemptAt     DateTime?                @map("next_attempt_at")
