generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/admin-client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum AdminTier {
  SUPER
  EXECUTIVE
  ADMIN
  EMPLOYEE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum Department {
  FINANCE
  DEVELOPMENT
  CUSTOMER_CARE
  MARKETING
  SOCIAL_MEDIA
  EXECUTIVE
  MANAGEMENT
  HR
  VERIFICATION
  RTC
  TELEMEDICINE
  OPERATIONS
}

enum SectionAccessMode {
  VIEW
  EDIT
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_DELETED
  TICKET_RESOLVED
  TICKET_ASSIGNED
  TICKET_UPDATED
  PAYMENT_VIEWED
  APPOINTMENT_VIEWED
  TOKEN_REFRESHED
  PROFILE_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  AVATAR_UPDATED
  HRM_ATTENDANCE_CREATED
  HRM_ATTENDANCE_UPDATED
  HRM_LEAVE_APPROVED
  HRM_LEAVE_DENIED
  HRM_LEAVE_APPROVE_ALL
  HRM_PAYROLL_UPDATED
  HRM_VACANCY_CREATED
  HRM_VACANCY_UPDATED
  HRM_VACANCY_DELETED
  HRM_VACANCY_STATUS_UPDATED
  HRM_APPLICANT_STAGE_UPDATED
  HRM_EVENT_CREATED
  SECTION_GRANT_CREATED
  SECTION_GRANT_REVOKED
  EMERGENCY_OVERRIDE_USED
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskStatus {
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum LeaveType {
  SICK
  ANNUAL
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum PayrollStatus {
  PAID
  PENDING
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum VacancyStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum ApplicantStage {
  SCREENING
  INTERVIEW
  HIRED
  REJECTED
}

enum marketing_campaign_type_enum {
  Email
  Social
  Events
  Ads
}

enum marketing_campaign_status_enum {
  Active
  Drafts
  Completed
  Paused
  Archived
}

enum marketing_content_status_enum {
  Published
  Draft
}
enum marketing_promotion_status_enum {
  Upcoming
  Active
  Completed
  Ended
}

enum marketing_banner_status_enum {
  Active
  Inactive
  Expired
}

enum marketing_social_platform_enum {
  Facebook
  Instagram
  Youtube
  Twitter
  Tiktok
  LinkedIn
}

enum marketing_social_post_status_enum {
  Published
  Scheduled
  Draft
  Deleted
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN USER
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String
  name                 String
  position             String?
  department           Department?
  tier                 AdminTier   @default(EMPLOYEE)
  status               AdminStatus @default(PENDING)
  isTeamLead           Boolean     @default(false)
  failedLoginAttempts  Int         @default(0)
  googleId             String?     @unique
  mainAppUserId        String?     @unique
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  mustChangePassword   Boolean     @default(true)
  passwordResetToken   String?     @unique
  passwordResetExpires DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?

  // ── 2FA ────────────────────────────────────────────────────────
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // ── Avatar ─────────────────────────────────────────────────────
  avatarUrl          String?
  avatarCloudinaryId String?

  // ── Personal Info (self-editable) ──────────────────────────────
  preferredName String?
  birthday      DateTime?
  nationality   String?
  gender        String?
  maritalStatus String?

  // ── Contact Info (self-editable) ───────────────────────────────
  workPhone     String?
  homePhone     String?
  personalPhone String?
  fax           String?
  address       String?
  state         String?
  country       String?

  // ── Emergency Contact (self-editable) ──────────────────────────
  emergencyName     String?
  emergencyPhone    String?
  emergencyEmail    String?
  emergencyRelation String?

  // ── Employment Details — set by SUPER/EXECUTIVE ────────────────
  employmentType     String?
  employmentCategory String?
  location           String?

  // ── Sensitive — only SUPER/EXECUTIVE can write these ───────────
  salary Decimal? @db.Decimal(15, 2)
  bonus  Decimal? @db.Decimal(15, 2)
  equity Decimal? @db.Decimal(15, 2)

  // ── Relations ──────────────────────────────────────────────────
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  socialLinks      AdminSocialLink[]
  educations       AdminEducation[]
  documents        AdminDocument[]
  performanceNotes AdminPerformanceNote[]
  reports          AdminReport[]
  sectionGrants    AdminSectionGrant[]
  marketingCampaignTeamMemberships marketing_campaign_team_members[] @relation("marketing_campaign_team_members_adminUserIdToAdminUser")
  marketingContentItems            marketing_content_items[]          @relation("marketing_content_items_authorIdToAdminUser")

  // ── Work Section Relations ──────────────────────────────────────
  teamMemberships       TeamMember[]
  projectMemberships    ProjectMember[]
  assignedTasks         Task[]          @relation("TaskAssignee")
  createdTasks          Task[]          @relation("TaskAssigner")
  notifications         Notification[]
  attendanceLogs        AttendanceLog[]
  leaveRequests         LeaveRequest[]  @relation("LeaveRequestEmployee")
  reviewedLeaveRequests LeaveRequest[]  @relation("LeaveRequestReviewer")
  leaveBalances         LeaveBalance[]
  payrollRecords        PayrollRecord[]
  payslips              Payslip[]
  deductions            Deduction[]
  receipts              Receipt[]
  invoices              Invoice[]

  @@map("admin_users")
}

// MARKETING

model marketing_campaigns {
  id             String                         @id(map: "PK_marketing_campaigns") @default(uuid())
  title          String                         @db.VarChar(255)
  type           marketing_campaign_type_enum
  status         marketing_campaign_status_enum @default(Drafts)
  description    String?
  budget         Decimal?                       @db.Decimal(12, 2)
  progress       Int                            @default(0)
  launchDate     DateTime?                      @db.Date
  estCompletion  DateTime?                      @db.Date
  targetAudience String?
  duration       String?                        @db.VarChar(100)
  channels       Json?                          @db.Json
  overview       String?
  createdAt      DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                       @updatedAt @db.Timestamp(6)

  performance marketing_campaign_performance?
  timeline    marketing_campaign_timeline[]
  team        marketing_campaign_team_members[]

  @@index([status], map: "IDX_marketing_campaigns_status")
  @@index([type], map: "IDX_marketing_campaigns_type")
  @@index([launchDate], map: "IDX_marketing_campaigns_launchDate")
  @@index([createdAt], map: "IDX_marketing_campaigns_createdAt")
}

model marketing_campaign_performance {
  id             String              @id(map: "PK_marketing_campaign_performance") @default(uuid())
  campaignId     String              @unique(map: "UQ_marketing_campaign_performance_campaignId")
  opens          Int                 @default(0)
  clicks         Int                 @default(0)
  conversions    Int                 @default(0)
  totalReach     Int                 @default(0)
  engagementRate Decimal             @default(0) @db.Decimal(8, 2)
  conversionRate Decimal             @default(0) @db.Decimal(8, 2)
  costPerClick   Decimal             @default(0) @db.Decimal(10, 2)
  createdAt      DateTime            @default(now()) @db.Timestamp(6)
  updatedAt      DateTime            @updatedAt @db.Timestamp(6)

  campaign marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_performance_campaignId")

  @@index([campaignId], map: "IDX_marketing_campaign_performance_campaignId")
}

model marketing_campaign_timeline {
  id         String              @id(map: "PK_marketing_campaign_timeline") @default(uuid())
  campaignId String
  label      String              @db.VarChar(255)
  date       DateTime            @db.Date
  done       Boolean             @default(false)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now()) @db.Timestamp(6)
  updatedAt  DateTime            @updatedAt @db.Timestamp(6)

  campaign marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_timeline_campaignId")

  @@index([campaignId], map: "IDX_marketing_campaign_timeline_campaignId")
  @@index([sortOrder, date], map: "IDX_marketing_campaign_timeline_order")
}

model marketing_campaign_team_members {
  id          String              @id(map: "PK_marketing_campaign_team_members") @default(uuid())
  campaignId  String
  adminUserId String?
  role        String              @db.VarChar(150)
  createdAt   DateTime            @default(now()) @db.Timestamp(6)
  updatedAt   DateTime            @updatedAt @db.Timestamp(6)

  campaign marketing_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_campaign_team_members_campaignId")
  adminUser AdminUser? @relation("marketing_campaign_team_members_adminUserIdToAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_marketing_campaign_team_members_adminUserId")

  @@index([campaignId], map: "IDX_marketing_campaign_team_members_campaignId")
  @@index([adminUserId], map: "IDX_marketing_campaign_team_members_adminUserId")
}

model marketing_content_items {
  id          String                        @id(map: "PK_marketing_content_items") @default(uuid())
  title       String                        @db.VarChar(255)
  type        String                        @db.VarChar(100)
  authorId    String?
  authorName  String?                       @db.VarChar(255)
  link        String?                       @db.VarChar(1000)
  description String?
  status      marketing_content_status_enum @default(Draft)
  performance Int                           @default(0)
  createdAt   DateTime                      @default(now()) @db.Timestamp(6)
  updatedAt   DateTime                      @updatedAt @db.Timestamp(6)

  adminUser         AdminUser?                             @relation("marketing_content_items_authorIdToAdminUser", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_marketing_content_items_authorId")
  monthlyPerformance marketing_content_monthly_performance[]

  @@index([status], map: "IDX_marketing_content_items_status")
  @@index([authorId], map: "IDX_marketing_content_items_authorId")
  @@index([updatedAt], map: "IDX_marketing_content_items_updatedAt")
}

model marketing_content_monthly_performance {
  id        String                  @id(map: "PK_marketing_content_monthly_performance") @default(uuid())
  contentId String
  month     String                  @db.VarChar(20)
  value     Int                     @default(0)
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now()) @db.Timestamp(6)
  updatedAt DateTime                @updatedAt @db.Timestamp(6)

  content marketing_content_items @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_content_monthly_performance_contentId")

  @@index([contentId], map: "IDX_marketing_content_monthly_performance_contentId")
  @@index([sortOrder], map: "IDX_marketing_content_monthly_performance_sortOrder")
}

model marketing_notification_events {
  id                String   @id(map: "PK_marketing_notification_events") @default(uuid())
  eventCode         String   @unique(map: "UQ_marketing_notification_events_eventCode") @db.VarChar(20)
  event             String   @db.VarChar(255)
  notifyEnabled     Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  whatsappEnabled   Boolean  @default(true)
  smsEnabled        Boolean  @default(true)
  recipients        Json?    @db.Json
  validToDate       DateTime? @db.Date
  customerFullName  String?  @db.VarChar(255)
  customerEmail     String?  @db.VarChar(255)
  customerPhone     String?  @db.VarChar(50)
  customerCountry   String?  @db.VarChar(100)
  emailContent      Json?    @db.Json
  conditionalBlock  Json?    @db.Json
  whatsappContent   Json?    @db.Json
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @db.Timestamp(6)

  templates marketing_email_templates[]

  @@index([event], map: "IDX_marketing_notification_events_event")
  @@index([validToDate], map: "IDX_marketing_notification_events_validToDate")
  @@index([createdAt], map: "IDX_marketing_notification_events_createdAt")
}

model marketing_email_templates {
  id        String   @id(map: "PK_marketing_email_templates") @default(uuid())
  eventId   String
  validFrom DateTime @db.Date
  validTo   DateTime @db.Date
  language  String   @db.VarChar(20)
  status    String   @default("Active") @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  event marketing_notification_events @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_marketing_email_templates_eventId")

  @@index([eventId], map: "IDX_marketing_email_templates_eventId")
  @@index([validTo], map: "IDX_marketing_email_templates_validTo")
  @@index([createdAt], map: "IDX_marketing_email_templates_createdAt")
}

model marketing_social_accounts {
  id                String                         @id(map: "PK_marketing_social_accounts") @default(uuid())
  platform          marketing_social_platform_enum
  username          String                         @db.VarChar(255)
  connected         Boolean                        @default(true)
  encryptedPassword String?
  credentialsSaved  Boolean                        @default(false)
  createdAt         DateTime                       @default(now()) @db.Timestamp(6)
  updatedAt         DateTime                       @updatedAt @db.Timestamp(6)

  @@index([platform], map: "IDX_marketing_social_accounts_platform")
  @@index([connected], map: "IDX_marketing_social_accounts_connected")
  @@unique([platform, username], map: "UQ_marketing_social_accounts_platform_username")
}

model marketing_social_posts {
  id             String                            @id(map: "PK_marketing_social_posts") @default(uuid())
  platform       marketing_social_platform_enum
  caption        String
  description    String?
  excerpt        String?
  attachmentUrl  String?                           @db.VarChar(1000)
  attachmentUrls Json?                             @db.Json
  thumbnailUrl   String?                           @db.VarChar(1000)
  imageUrl       String?                           @db.VarChar(1000)
  postedAt       DateTime?                         @db.Timestamp(6)
  scheduledFor   DateTime?                         @db.Timestamp(6)
  status         marketing_social_post_status_enum @default(Draft)
  followers      Int                               @default(0)
  views          Int                               @default(0)
  totalLikes     Int                               @default(0)
  comments       Int                               @default(0)
  locations      Json?                             @db.Json
  performance    Json?                             @db.Json
  createdAt      DateTime                          @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                          @updatedAt @db.Timestamp(6)

  @@index([platform], map: "IDX_marketing_social_posts_platform")
  @@index([status], map: "IDX_marketing_social_posts_status")
  @@index([postedAt], map: "IDX_marketing_social_posts_postedAt")
  @@index([scheduledFor], map: "IDX_marketing_social_posts_scheduledFor")
  @@index([createdAt], map: "IDX_marketing_social_posts_createdAt")
}

model marketing_social_analytics_snapshots {
  id                    String   @id(map: "PK_marketing_social_analytics_snapshots") @default(uuid())
  stats                 Json?    @db.Json
  locations             Json?    @db.Json
  audience              Json?    @db.Json
  recentUpload          Json?    @db.Json
  weeklyEngagement      Json?    @db.Json
  totalEngagementChange String?  @db.VarChar(50)
  createdAt             DateTime @default(now()) @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @db.Timestamp(6)

  @@index([createdAt], map: "IDX_marketing_social_analytics_snapshots_createdAt")
}

model marketing_promotions {
  id           String                          @id(map: "PK_marketing_promotions") @default(uuid())
  title        String                          @db.VarChar(255)
  discountType String                          @db.VarChar(255)
  startDate    DateTime                        @db.Date
  endDate      DateTime                        @db.Date
  grossSales   Int                             @default(0)
  averageRate  Decimal                         @default(0) @db.Decimal(8, 2)
  grossRevenue Decimal                         @default(0) @db.Decimal(12, 2)
  status       marketing_promotion_status_enum @default(Upcoming)
  createdAt    DateTime                        @default(now()) @db.Timestamp(6)
  updatedAt    DateTime                        @updatedAt @db.Timestamp(6)

  @@index([status], map: "IDX_marketing_promotions_status")
  @@index([startDate], map: "IDX_marketing_promotions_startDate")
  @@index([endDate], map: "IDX_marketing_promotions_endDate")
  @@index([createdAt], map: "IDX_marketing_promotions_createdAt")
}

model marketing_banners {
  id                 String                       @id(map: "PK_marketing_banners") @default(uuid())
  mediaType          String                       @db.VarChar(100)
  fileName           String?                      @db.VarChar(255)
  fileUrl            String?                      @db.VarChar(1000)
  imageUrl           String?                      @db.VarChar(1000)
  cloudinaryId       String?                      @db.VarChar(255)
  title              String                       @db.VarChar(255)
  description        String
  display            Json?                        @db.Json
  placement          Json?                        @db.Json
  externalLink       String                       @db.VarChar(1000)
  startDate          DateTime                     @db.Date
  endDate            DateTime                     @db.Date
  status             marketing_banner_status_enum @default(Inactive)
  totalImpressions   Int                          @default(0)
  impressionsChange  Decimal                      @default(0) @db.Decimal(8, 2)
  clicks             Int                          @default(0)
  clicksChange       Decimal                      @default(0) @db.Decimal(8, 2)
  signup             Int                          @default(0)
  signupChange       Decimal                      @default(0) @db.Decimal(8, 2)
  createdAt          DateTime                     @default(now()) @db.Timestamp(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamp(6)

  @@index([status], map: "IDX_marketing_banners_status")
  @@index([startDate], map: "IDX_marketing_banners_startDate")
  @@index([endDate], map: "IDX_marketing_banners_endDate")
  @@index([createdAt], map: "IDX_marketing_banners_createdAt")
}

model marketing_analytics_snapshots {
  id                   String   @id(map: "PK_marketing_analytics_snapshots") @default(uuid())
  overviewStats        Json?    @db.Json
  socialStats          Json?    @db.Json
  adsPerformance       Json?    @db.Json
  locations            Json?    @db.Json
  audienceBreakdown    Json?    @db.Json
  conversionFunnel     Json?    @db.Json
  weeklyEngagement     Json?    @db.Json
  performanceData      Json?    @db.Json
  platformIntegrations Json?    @db.Json
  createdAt            DateTime @default(now()) @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @db.Timestamp(6)

  @@index([createdAt], map: "IDX_marketing_analytics_snapshots_createdAt")
}


// ─────────────────────────────────────────────────────────────────────────────
// AUTH

// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("admin_refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetId    String?
  targetType  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION-LEVEL PERMISSIONS (Addendum 2)
// ─────────────────────────────────────────────────────────────────────────────

// One row = one person granted access to one specific section of one module,
// independent of their home Department. Home role templates are just a
// default starter set of these grants, applied at account creation.
model AdminSectionGrant {
  id          String            @id @default(uuid())
  adminUserId String
  adminUser   AdminUser         @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  module      String // e.g. "hrm", "finance", "verification"
  section     String // e.g. "accounts", "payroll", "doctors" — use "*" for whole-module
  mode        SectionAccessMode
  grantedBy   String // id of the account that issued the grant
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  revokedAt   DateTime?

  @@index([adminUserId])
  @@index([module, section])
  @@map("admin_section_grants")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILE — Social Links, Education, Documents, Performance Notes, Reports
// ─────────────────────────────────────────────────────────────────────────────

model AdminSocialLink {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  platform    String
  username    String
  createdAt   DateTime  @default(now())

  @@map("admin_social_links")
}

model AdminEducation {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  degreeTitle String
  institution String
  from        String?
  to          String?
  createdAt   DateTime  @default(now())

  @@map("admin_educations")
}

// Uploaded by SUPER/EXECUTIVE on behalf of the employee. Employee is read-only.
model AdminDocument {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  name         String
  title        String? // display title separate from the raw filename
  type         String // "pdf", "docx", "jpg" etc.
  url          String // Cloudinary secure URL
  cloudinaryId String? // Cloudinary public_id — needed to delete the file
  uploadedBy   String // id of the SUPER/EXECUTIVE who uploaded it
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  @@map("admin_documents")
}

// Written BY a SUPER/EXECUTIVE ABOUT an employee. Employee is read-only.
model AdminPerformanceNote {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title        String
  type         String    @default("docx")
  url          String // Cloudinary secure URL
  cloudinaryId String?
  createdBy    String // id of the SUPER/EXECUTIVE who wrote it
  date         DateTime  @default(now())

  @@map("admin_performance_notes")
}

// Written BY the employee themselves (leave resumption, milestone, etc.)
// Text-based — no file upload.
model AdminReport {
  id           String    @id @default(uuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title        String
  type         String?   @default("text")
  body         String?
  note         String?
  url          String?
  cloudinaryId String?
  createdBy    String
  date         DateTime  @default(now())

  @@map("admin_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORK SECTION — Teams
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id         String      @id @default(uuid())
  title      String
  department Department?
  createdBy  String // id of the SUPER/EXECUTIVE who created the team
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members  TeamMember[]
  projects Project[]

  @@map("teams")
}

// Join table: AdminUser ↔ Team
model TeamMember {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  isTeamLead  Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  @@unique([teamId, adminUserId])
  @@map("team_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORK SECTION — Projects
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(uuid())
  title        String
  description  String?
  assignedDate DateTime      @default(now())
  dueDate      DateTime
  teamId       String
  team         Team          @relation(fields: [teamId], references: [id])
  status       ProjectStatus @default(IN_PROGRESS)
  createdBy    String // id of the admin who created the project
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignees ProjectMember[]
  tasks     Task[]

  @@map("projects")
}

// Join table: AdminUser ↔ Project (individual assignees beyond the whole team)
model ProjectMember {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([projectId, adminUserId])
  @@map("project_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORK SECTION — Tasks
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  assignedDate DateTime   @default(now())
  dueDate      DateTime
  projectId    String? // optional — tasks can exist outside a project
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignerId   String
  assigner     AdminUser  @relation("TaskAssigner", fields: [assignerId], references: [id])
  assigneeId   String
  assignee     AdminUser  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status       TaskStatus @default(IN_PROGRESS)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

// -----------------------------------------------------------------------------
// HRM ATTENDANCE AND LEAVES
// -----------------------------------------------------------------------------

model AttendanceLog {
  id          String           @id @default(uuid())
  adminUserId String
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      AttendanceStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, date])
  @@index([adminUserId])
  @@index([date])
  @@index([status])
}

model LeaveRequest {
  id             String             @id @default(uuid())
  adminUserId    String
  leaveType      LeaveType
  startDate      DateTime
  resumptionDate DateTime
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  attachmentUrl  String?
  attachmentName String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  adminUser  AdminUser  @relation("LeaveRequestEmployee", fields: [adminUserId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([status])
  @@index([startDate])
  @@index([reviewedById])
}

model LeaveBalance {
  id            String    @id @default(uuid())
  adminUserId   String
  leaveType     LeaveType
  year          Int
  availableDays Int       @default(0)
  usedDays      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, leaveType, year])
  @@index([adminUserId])
  @@index([year])
}

model Notification {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  icon        String // "alert" | "xcircle" | "settings" | "check" | "bell"
  title       String
  subtitle    String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// HRM PAYROLL
// ─────────────────────────────────────────────────────────────────────────────

model PayrollRecord {
  id              String        @id @default(uuid())
  adminUserId     String
  month           Int
  year            Int
  totalSalary     Decimal       @default(0) @db.Decimal(15, 2)
  totalAllowance  Decimal       @default(0) @db.Decimal(15, 2)
  totalBonus      Decimal       @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(15, 2)
  grossPay        Decimal       @default(0) @db.Decimal(15, 2)
  netPay          Decimal       @default(0) @db.Decimal(15, 2)
  status          PayrollStatus @default(PENDING)
  paymentMethod   String?
  bankName        String?
  bankAccount     String?
  paymentDate     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser  AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payslips   Payslip[]
  deductions Deduction[]
  receipts   Receipt[]
  invoices   Invoice[]

  @@unique([adminUserId, month, year])
  @@index([adminUserId])
  @@index([month, year])
  @@index([status])
  @@map("payroll_records")
}

model Payslip {
  id              String        @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  month           Int
  year            Int
  basicSalary     Decimal       @default(0) @db.Decimal(15, 2)
  allowance       Decimal       @default(0) @db.Decimal(15, 2)
  bonus           Decimal       @default(0) @db.Decimal(15, 2)
  deductionsJson  Json?
  netPay          Decimal       @default(0) @db.Decimal(15, 2)
  paymentMethod   String?
  paymentDate     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("payslips")
}

model Deduction {
  id              String        @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  name            String
  amount          Decimal       @default(0) @db.Decimal(15, 2)
  month           Int
  year            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("deductions")
}

model Receipt {
  id              String        @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  amount          Decimal       @default(0) @db.Decimal(15, 2)
  description     String?
  month           Int
  year            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@map("receipts")
}

model Invoice {
  id              String        @id @default(uuid())
  adminUserId     String
  payrollRecordId String?
  amount          Decimal       @default(0) @db.Decimal(15, 2)
  description     String?
  dueDate         DateTime?
  status          InvoiceStatus @default(PENDING)
  month           Int
  year            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([month, year])
  @@index([status])
  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// HRM HIRING
// ─────────────────────────────────────────────────────────────────────────────

model JobVacancy {
  id                String        @id @default(uuid())
  title             String
  department        Department?
  category          String?
  location          String?
  numberOfOpening   Int           @default(1)
  experienceLevel   String?
  salaryRange       String?
  benefitsAndBonus  String?
  jobDescription    String?
  responsibilities  String?
  requirements      String?
  hiringStages      Json?
  assignedRecruiter String?
  deadline          DateTime?
  status            VacancyStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applicants JobApplicant[]

  @@index([status])
  @@index([department])
  @@map("job_vacancies")
}

model JobApplicant {
  id              String         @id @default(uuid())
  vacancyId       String
  fullName        String
  email           String?
  phone           String?
  country         String?
  stage           ApplicantStage @default(SCREENING)
  via             String?
  applicationDate DateTime       @default(now())
  coverLetter     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vacancy     JobVacancy               @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  attachments JobApplicantAttachment[]

  @@index([vacancyId])
  @@index([stage])
  @@map("job_applicants")
}

model JobApplicantAttachment {
  id          String   @id @default(uuid())
  applicantId String
  url         String
  name        String?
  type        String?
  createdAt   DateTime @default(now())

  applicant JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("job_applicant_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// HRM PERFORMANCE — Events
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}