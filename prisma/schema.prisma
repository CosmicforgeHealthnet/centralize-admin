  publishedAt       DateTime?               @map("published_at")
  lastError         String?                 @map("last_error")
  lastErrorCategory String?                 @map("last_error_category")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  attempts        SocialPublicationAttempt[]
  job             SocialPublishingJob?
  providerContent SocialProviderContent?
  actionJobs      SocialActionJob[]

  @@unique([targetId, postVersion])
  @@index([status])
  @@map("social_publications")
}

model SocialPublicationAttempt {
  id               String            @id @default(uuid()) @db.Uuid
  publicationId    String            @map("publication_id") @db.Uuid
  publication      SocialPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  attemptNo        Int               @map("attempt_no")
  category         String?
  responseMetaJson Json?             @map("response_meta_json")
  startedAt        DateTime          @default(now()) @map("started_at")
  finishedAt       DateTime?         @map("finished_at")

