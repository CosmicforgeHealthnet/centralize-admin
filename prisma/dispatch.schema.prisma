generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/dispatch-client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability_sessions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id      String    @unique(map: "idx_sessions_provider_open", where: raw("(went_offline_at IS NULL)")) @db.Uuid
  went_online_at   DateTime  @db.Timestamptz(6)
  went_offline_at  DateTime? @db.Timestamptz(6)
  duration_minutes Int?
  trips_in_session Int       @default(0)
  forced_offline   Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  providers        providers @relation(fields: [provider_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([went_online_at], map: "idx_sessions_online_at")
  @@index([provider_id], map: "idx_sessions_provider")
}

