/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trips {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String           @unique(map: "idx_trips_booking") @db.Uuid
  provider_id     String           @db.Uuid
  customer_id     String           @db.Uuid
  status          String           @default("assigned")
  pickup_address  String
  pickup_lat      Decimal          @db.Decimal(10, 7)
  pickup_lng      Decimal          @db.Decimal(10, 7)
  dropoff_address String
  dropoff_lat     Decimal          @db.Decimal(10, 7)
  dropoff_lng     Decimal          @db.Decimal(10, 7)
  distance_km     Decimal          @default(0) @db.Decimal(8, 2)
  fare_amount     BigInt
  currency        String           @default("NGN")
  receiver_name   String
  receiver_phone  String
  package_desc    String?
  package_weight  Decimal?         @db.Decimal(6, 2)
  started_at      DateTime?        @db.Timestamptz(6)
  arrived_at      DateTime?        @db.Timestamptz(6)
  completed_at    DateTime?        @db.Timestamptz(6)
  cancelled_at    DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  cancellations   cancellations?
  delivery_proofs delivery_proofs?
  trip_state_log  trip_state_log[]
  providers       providers        @relation(fields: [provider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_trips_created_at")
  @@index([provider_id], map: "idx_trips_provider")
  @@index([provider_id, status], map: "idx_trips_provider_active", where: raw("(status <> ALL (ARRAY['completed'::text, 'cancelled'::text, 'failed'::text]))"))
  @@index([provider_id, created_at(sort: Desc)], map: "idx_trips_provider_created_at")
  @@index([status], map: "idx_trips_status")
}

